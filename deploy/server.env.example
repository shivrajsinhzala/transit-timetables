# Copy to deploy/server.env (not committed) and fill in.
# How `ssh` reaches the server: user@host, or a Host alias from ~/.ssh/config.
DEPLOY_SSH=deploy@203.0.113.10
# Where releases go; must match `root` in deploy/nginx.conf (plus /current).
DEPLOY_PATH=/var/www/stopwatch
# Optional: purge Cloudflare's cached pages after each release (else they update within a day).
# Zone ID: Cloudflare dashboard > stopwatchtimetables.com > Overview (right column, API section).
# Token: My Profile > API Tokens > Create Token > Custom: Zone > Cache Purge > Purge, for the zones below.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# Optional: the old host's zone (shivrajsinh.in), so its redirects are purged too after the switch.
CLOUDFLARE_OLD_ZONE_ID=
# SITE_URL and MIGRATION_REDIRECTS are environment variables, not settings here: see src/lib/site.js
# (SITE_URL defaults to https://stopwatchtimetables.com, MIGRATION_REDIRECTS to off).
