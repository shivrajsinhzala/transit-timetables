---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { SYSTEM_INDEX, COUNTRIES, countries, systemsIn } from '../lib/data.js';
import { plain } from '../lib/format.js';
import { LANG, countryNames } from '../lib/page.js';

interface Props {
  title: string;
  description: string;
  /** Path without the leading slash; '' for the homepage. */
  path: string;
  jsonLd?: unknown[];
  /** Pages that should not be in Google (e.g. 404, offline). */
  noindex?: boolean;
  /** Path of the page Google should show instead (a minor route variant names its main route). */
  canonicalPath?: string;
  /** Share image path under /og, e.g. 'kelowna' for public/og/kelowna.png. */
  og?: string;
  /** schema.org page type: WebPage, CollectionPage, AboutPage… */
  pageType?: string;
  /** ISO date the page's content last changed (the timetable refresh date). */
  modified?: string;
  /** CSS selectors of the parts a voice assistant should read out. */
  speakable?: string[];
  /** The transit system a page belongs to: sets the language, the clock and the footer credit. */
  system?: any;
  /** Country code for pages that belong to a country but not a system. */
  cc?: string;
  lang?: string;
}

const { title, description, path, jsonLd = [], noindex = false, og = 'default', pageType = 'WebPage', modified, speakable, system } = Astro.props;
const cc = system?.cc || Astro.props.cc || null;
const lang = Astro.props.lang || (cc ? LANG[cc] : 'en');
const h24 = cc ? COUNTRIES[cc].h24 : false;
const allCountries = countries();
const footSystems = cc ? [...systemsIn(cc)].sort((a, b) => b.routes - a.routes).slice(0, 36) : [];
const credit = system?.attribution;
const SITE = 'https://transit.shivrajsinh.in';
// The homepage is canonical with its trailing slash: that is the URL in the sitemap, and the
// one Search Console and the crawl audit compare against.
const canonical = path ? `${SITE}/${path}` : `${SITE}/`;
// The page's own URL stays its @id; only the canonical link and og:url point elsewhere.
const canonicalHref = Astro.props.canonicalPath ? `${SITE}/${Astro.props.canonicalPath}` : canonical;
const updated = modified || SYSTEM_INDEX[0]?.builtOn;

/*
 * One entity graph for the whole site: the site, the organisation behind it and its founder,
 * referenced by @id from every page so AI engines see one consistent "Stopwatch" entity.
 */
const ORG_ID = `${SITE}/#organization`;
const SITE_ID = `${SITE}/#website`;
const PERSON_ID = `${SITE}/about#shivrajsinh`;
const pageLd = {
  '@context': 'https://schema.org',
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': SITE_ID },
  publisher: { '@id': ORG_ID },
  ...(updated ? { dateModified: updated } : {}),
  ...(speakable?.length ? { speakable: { '@type': 'SpeakableSpecification', cssSelector: speakable } } : {}),
};
const entityLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE_ID, name: 'Stopwatch', alternateName: 'Stopwatch transit timetables', url: `${SITE}/`, inLanguage: 'en', publisher: { '@id': ORG_ID } },
  {
    '@context': 'https://schema.org', '@type': 'Organization', '@id': ORG_ID, name: 'Stopwatch', url: `${SITE}/`,
    logo: { '@type': 'ImageObject', url: `${SITE}/icon-512.png`, width: 512, height: 512 },
    description: `Independent website publishing bus, tram, train and ferry timetables for ${SYSTEM_INDEX.length} transit systems in ${countryNames(allCountries)}, built from the operators' open data.`,
    founder: { '@type': 'Person', '@id': PERSON_ID, name: 'Shivrajsinh Zala', jobTitle: 'Web developer', url: 'https://shivrajsinh.in', sameAs: ['https://shivrajsinh.in', 'https://github.com/shivrajsinhzala'] },
    areaServed: allCountries.map((c) => ({ '@type': 'Country', name: c.name })),
  },
];
const AD_CLIENT = 'ca-pub-7164999486301748';
---
<!doctype html>
<html lang={lang} data-h24={h24 ? '' : undefined}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalHref} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
  <link rel="preconnect" href="https://googleads.g.doubleclick.net" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Stopwatch" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalHref} />
  <meta property="og:image" content={`${SITE}/og/${og}.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#f2f2f7" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="google-adsense-account" content={AD_CLIENT} />
  <script is:inline>document.documentElement.classList.add('js')</script>
  {[pageLd, ...(path === '' || path === 'about' ? entityLd : []), ...jsonLd].map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  <a class="sr" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="/" aria-label="Stopwatch home"><Logo /> Stopwatch</a>
      <nav class="head-nav" aria-label="Site">
        <a href={cc ? `/${cc}` : '/#countries'} class="hide-sm">{cc ? COUNTRIES[cc].name : 'Countries'}</a>
        <a href="/about" class="hide-sm">About</a>
        <button class="search-trigger" type="button" data-search-open aria-label="Search routes and stops">
          <Icon name="magnifying-glass" /><span class="label">Route, stop or town</span><kbd>/</kbd>
        </button>
      </nav>
    </div>
  </header>

  <div id="main"><slot /></div>

  <footer class="site-foot">
    <div class="wrap foot-grid">
      <div>
        <a class="brand" href="/"><Logo size={26} /> Stopwatch</a>
        <p style="margin-top:1rem">
          {SYSTEM_INDEX.length} transit systems in {allCountries.length} countries, every timetable on one screen with the next departure first.
          {credit
            ? <> {system.name} times come from <a href={credit.url} rel="nofollow">{plain(credit.text)}</a> open data{credit.license && <>, used under {/licen[cs]e|terms/i.test(credit.license) ? 'the ' : ''}<a href={credit.licenseUrl} rel="nofollow license">{plain(credit.license)}</a></>}.</>
            : <> Built from the open schedule data that operators and transport authorities publish; every timetable page names its source and licence.</>}
        </p>
        <p>
          Stopwatch is independent. It is not run by, affiliated with or endorsed by {credit ? plain(credit.text) : 'any transit operator'} or any
          government. Times are scheduled, not live; disruptions and alerts are on the operator’s own channels.
        </p>
        <p><a href="/about">About</a> · <a href="/privacy">Privacy</a></p>
      </div>
      <nav aria-label="Countries and systems">
        <ul class="foot-countries">
          {allCountries.map((c) => <li><a href={`/${c.cc}`} aria-current={c.cc === cc ? 'true' : undefined}>{c.name} <small>{c.systems.length}</small></a></li>)}
        </ul>
        {footSystems.length > 0 && (
          <ul class="foot-towns">
            {footSystems.map((t) => <li><a href={`/${t.key}`}>{t.name}</a></li>)}
          </ul>
        )}
      </nav>
    </div>
  </footer>

  <dialog class="search" id="search" aria-label="Search">
    <div class="search-box">
      <label for="search-input"><Icon name="magnifying-glass" /><span class="sr">Search</span></label>
      <input id="search-input" type="search" autocomplete="off" spellcheck="false" placeholder="Route 96, Kelowna, Abingdon Street…" />
      <button class="btn btn-sm btn-quiet" type="button" data-search-close aria-label="Close search"><Icon name="x" /></button>
    </div>
    <ul class="search-results" id="search-results" role="listbox" aria-label="Results"></ul>
    <div class="search-foot">
      <button class="btn btn-sm btn-quiet" type="button" data-near-me><Icon name="navigation-arrow" /> Stops near me</button>
      <span>Enter to open · Esc to close</span>
    </div>
  </dialog>

  <script>
    import '../scripts/app.js';
  </script>
</body>
</html>
