---
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import Ad from '../../../../components/Ad.astro';
import RouteBadge from '../../../../components/RouteBadge.astro';
import Faq from '../../../../components/Faq.astro';
import { allSystems, pageStops, hubOf, nearby, REGION } from '../../../../lib/data.js';
import { clockText, byHour, longDate, place, plain, inkFor, possessive } from '../../../../lib/format.js';

export function getStaticPaths() {
  return allSystems().flatMap((system) => pageStops(system.slug).map((stop) => ({
    params: { system: system.slug, code: stop.code },
    props: { system, stop },
  })));
}

const { system, stop } = Astro.props;
const name = plain(stop.name);
const routeOf = (slug) => system.routes.find((x) => x.slug === slug);
const routeNums = [...new Set(stop.routes.map((r) => r.short || r.name))];
const routeList = routeNums.length > 1 ? `${routeNums.slice(0, -1).join(', ')} and ${routeNums.at(-1)}` : routeNums[0];
const firstAll = Math.min(...stop.routes.flatMap((r) => Object.values(r.times).flat()));
const toward = (h) => place(plain(h).replace(/^.*-\s*To\s+/i, '').replace(/^To\s+/i, ''));
const hub = hubOf(system.slug, stop);
const near = nearby(system.slug, stop);

// Departures by weekday (0 = Monday), across every route that calls here.
const WEEKDAY = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const timesOn = (wd) => stop.routes.flatMap((r) => {
  const d = routeOf(r.route)?.days.find((x) => x.days.includes(wd));
  return (d && r.times[d.key]) || [];
}).sort((a, b) => a - b);
const span = (wd) => { const t = timesOn(wd); return t.length ? { first: t[0], last: t.at(-1), n: t.length, day: t.filter((m) => m >= 420 && m < 1140).length } : null; };
const mon = span(0), sat = span(5), sun = span(6);
const lines = [...new Map(stop.routes.map((r) => [`${r.short || r.name}>${toward(r.headsign)}`, `${r.short ? `Route ${r.short}` : plain(r.name)} to ${toward(r.headsign)}`])).values()];
const spanText = (label, x) => (x ? `${label}: first bus ${clockText(x.first)}, last ${clockText(x.last)} (${x.n} buses)` : `${label}: no buses`);
const perHour = mon?.day ? mon.day / 12 : 0;

// "orchard park exchange bay f" is a real autocomplete query: the stop's own name leads, and
// the stop number is always kept so stops sharing a name (two sides of one road) never share a title.
const fit = (max, ...c) => c.find((s) => s.length <= max) ?? c.at(-1);
const title = fit(60, `${name} Bus Times (Stop ${stop.code})`, `${name} (Stop ${stop.code})`, `${name.slice(0, 44).trim()}… (Stop ${stop.code})`);
const description = fit(160,
  `Bus times at ${name}, ${system.name} (stop #${stop.code}): ${routeNums.length > 1 ? 'routes' : 'route'} ${routeList}.${mon ? ` Weekdays ${clockText(mon.first)} to ${clockText(mon.last)}.` : ''} Next bus and full timetable.`,
  `Bus times at ${name}, ${system.name} (stop #${stop.code}): ${routeNums.length > 1 ? 'routes' : 'route'} ${routeList}. Next bus and full timetable.`,
  `Bus times at ${name}, ${system.name} (stop #${stop.code}). Next bus and full timetable.`);

const faq = [
  [`Which buses stop at ${name}?`, `${lines.join(', ')} ${lines.length === 1 ? 'stops' : 'stop'} at ${name} (stop #${stop.code}) in ${system.name}.`],
  [`When is the first and last bus at ${name}?`, `${[spanText('Monday', mon), spanText('Saturday', sat), spanText('Sunday', sun)].join('. ')}. Holiday timetables can differ; each route page lists them.`],
  ...(mon && mon.day ? [[`How often do buses come to ${name}?`, perHour >= 1 ? `On a Monday about ${Math.round(perHour)} bus${Math.round(perHour) === 1 ? '' : 'es'} an hour stop here between 7 am and 7 pm (${mon.day} in those twelve hours, all routes together).` : `On a Monday ${mon.day} bus${mon.day === 1 ? '' : 'es'} stop here between 7 am and 7 pm, roughly one every ${Math.round(720 / mon.day)} minutes.`]] : []),
  ...(hub ? [[`Is ${name} part of ${plain(hub.name)}?`, `Yes. It is one of ${hub.stops.length} bays at ${plain(hub.name)}. The ${plain(hub.name)} page lists the next departures from every bay and which routes use each one.`]] : []),
  ...(near.length ? [[`What other stops are near ${name}?`, `The closest are ${near.slice(0, 3).map(({ stop: s, m }) => `${plain(s.name)} (#${s.code}, about ${Math.max(1, Math.round(m / 80))} min walk)`).join(', ')}.`]] : []),
  ['Are these live arrival times?', `No. They are the scheduled times from ${possessive(system.name)} published timetable, refreshed ${longDate(system.builtOn)}. A bus can run early or late, and detours are not shown.`],
];

const SITE = 'https://transit.shivrajsinh.in';
const path = `bc/${system.slug}/stop/${stop.code}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: REGION.name, item: `${SITE}/${REGION.slug}` },
      { '@type': 'ListItem', position: 2, name: `${system.name} buses`, item: `${SITE}/bc/${system.slug}` },
      { '@type': 'ListItem', position: 3, name, item: `${SITE}/${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BusStop',
    name,
    identifier: stop.code,
    ...(stop.lat ? { geo: { '@type': 'GeoCoordinates', latitude: stop.lat, longitude: stop.lon } } : {}),
    containedInPlace: { '@type': 'City', name: system.name },
  },
];
const cfg = { tz: system.timezone, routes: Object.fromEntries(stop.routes.map((r) => { const x = routeOf(r.route); return [`${r.route}|${r.headsign}`, { days: x?.days.map(({ key, days }) => ({ key, days })) || [], exceptions: x?.exceptions.map(({ date, runs }) => ({ date, runs })) || [] }]; })) };
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} og={system.slug} modified={system.builtOn} speakable={['.lede', '.faq .answer']}>
<main class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/bc">{REGION.name}</a> › <a href={`/bc/${system.slug}`}>{system.name}</a>{hub && <> › <a href={`/bc/${system.slug}/hub/${hub.slug}`}>{plain(hub.name)}</a></>} › Stop {stop.code}</nav>
  <div class="page-head">
    <Icon name="map-pin" class="lg" />
    <div>
      <h1>{name}</h1>
      <p class="sub">Stop #{stop.code} · {system.name} · Route{routeNums.length > 1 ? 's' : ''} {routeList}</p>
    </div>
  </div>
  <div class="actions">
    <button class="btn btn-quiet btn-sm" type="button" data-fav={`stop:${system.slug}/${stop.code}`} data-name={name} data-sub={`${system.name} · #${stop.code}`}><Icon name="star" /><span data-fav-label>Save</span></button>
    <button class="btn btn-quiet btn-sm" type="button" data-share><Icon name="share-network" /><span data-share-label>Share</span></button>
    {stop.lat && <a class="btn btn-quiet btn-sm" href={`https://www.google.com/maps/search/?api=1&query=${stop.lat},${stop.lon}`} rel="nofollow"><Icon name="map-trifold" /> Directions</a>}
    {hub && <a class="btn btn-quiet btn-sm" href={`/bc/${system.slug}/hub/${hub.slug}`}><Icon name="bus" /> All {plain(hub.name)} bays</a>}
  </div>

  <p class="lede" style="margin-top:1.2rem">{name} is a bus stop in {system.name} (stop #{stop.code}) served by {lines.join(', ')}.{mon ? ` On weekdays buses run from ${clockText(mon.first)} to ${clockText(mon.last)}.` : ''}{hub ? ` It is one of ${hub.stops.length} bays at ${plain(hub.name)}.` : ''}</p>

  <div class="board" data-board data-rows="6" style="margin-top:1.4rem" aria-label={`Next scheduled buses at ${name}`}>
    <div class="board-head"><strong>Next buses here</strong><span class="board-clock" data-clock></span></div>
    <ol><li class="empty">Loading the next buses…</li></ol>
    <p class="board-foot">Scheduled times. The first bus of the day leaves at {clockText(firstAll)}.</p>
  </div>

  <Ad />

  {stop.routes.map((r) => { const key = `${r.route}|${r.headsign}`; const route = routeOf(r.route); return (
    <section class="direction stop-route" data-section data-route={key} data-short={r.short || ''} data-color={r.color || ''} data-text={inkFor(r.color)} data-to={toward(r.headsign)} data-url={`/bc/${system.slug}/${r.route}`}>
      <h2><a href={`/bc/${system.slug}/${r.route}`} style="text-decoration:none" aria-label={`${r.short ? `Route ${r.short}` : plain(r.name)} timetable`}><RouteBadge route={{ short: r.short, color: r.color, textColor: route?.textColor }} /></a> {r.short ? `Route ${r.short}` : plain(r.name)} <span class="muted">to {toward(r.headsign)}</span></h2>
      <div class="tabs" role="tablist" aria-label="Day of the week">
        {r.days.filter((d) => r.times[d.key]).map((d, i) => <button type="button" role="tab" data-day={d.key} aria-selected={i === 0 ? 'true' : 'false'}>{d.label}</button>)}
      </div>
      <p class="next-line" aria-live="polite"></p>
      {r.days.filter((d) => r.times[d.key]).map((d, i) => (
        <div class={`panel${i === 0 ? ' on' : ''}`} data-day={d.key} role="tabpanel">
          <h3>{d.label}, {r.times[d.key].length} buses</h3>
          <table class="hours">
            <tbody>
              {byHour(r.times[d.key]).map((h) => (
                <tr><th class={h.pm ? 'pm' : undefined}>{h.label}<span class="sr">{h.pm ? ' pm' : ' am'}</span></th><td>{h.mins.map((m) => <span data-m={m.m}>{m.text}</span>)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>
  ); })}

  <p class="small muted" style="margin-top:1.5rem">Read each row as the hour, then the minutes past it: 7 then 05 35 means 7:05 and 7:35. <b>Bold hours are pm.</b> Scheduled times from {possessive(system.name)} official transit data, refreshed {longDate(system.builtOn)}. Not live arrivals.</p>

  <Faq items={faq} title={`Questions about ${name}`} />
  <p class="small muted source">Source: <a href="https://www.bctransit.com/open-data/">BC Transit open data</a> (GTFS schedule for {system.name}), refreshed {longDate(system.builtOn)}.</p>

  {near.length > 0 && (
    <section>
      <h2>Stops nearby</h2>
      <ul class="list">
        {near.map(({ stop: s, m }) => <li><a href={`/bc/${system.slug}/stop/${s.code}`}><Icon name="map-pin" /><span>{plain(s.name)}<span class="meta">#{s.code} · about {Math.max(1, Math.round(m / 80))} min walk ({Math.round(m / 10) * 10} m)</span></span><Icon name="arrow-right" class="go" /></a></li>)}
      </ul>
    </section>
  )}
</main>
<script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />
</Base>
