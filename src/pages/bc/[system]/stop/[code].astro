---
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import Ad from '../../../../components/Ad.astro';
import RouteBadge from '../../../../components/RouteBadge.astro';
import { allSystems, pageStops, hubOf, nearby, REGION } from '../../../../lib/data.js';
import { clockText, byHour, longDate, place, plain, inkFor } from '../../../../lib/format.js';

export function getStaticPaths() {
  return allSystems().flatMap((system) => pageStops(system.slug).map((stop) => ({
    params: { system: system.slug, code: stop.code },
    props: { system, stop },
  })));
}

const { system, stop } = Astro.props;
const name = plain(stop.name);
const routeOf = (slug) => system.routes.find((x) => x.slug === slug);
const routeNums = [...new Set(stop.routes.map((r) => r.short || r.name))];
const routeList = routeNums.length > 1 ? `${routeNums.slice(0, -1).join(', ')} and ${routeNums.at(-1)}` : routeNums[0];
const firstAll = Math.min(...stop.routes.flatMap((r) => Object.values(r.times).flat()));
const toward = (h) => place(plain(h).replace(/^.*-\s*To\s+/i, '').replace(/^To\s+/i, ''));
const hub = hubOf(system.slug, stop);
const near = nearby(system.slug, stop);

// "orchard park exchange bay f" is a real autocomplete query: the stop's own name leads.
const fit = (max, ...c) => c.find((s) => s.length <= max) ?? c.at(-1);
const title = fit(60, `${name} Bus Times (Stop ${stop.code})`, `${name}: Bus Times, ${system.name}`, `${name} Bus Times`, `Stop ${stop.code} Bus Times, ${system.name}`);
const description = fit(160,
  `Next buses and the full timetable at ${name}, ${system.name} (stop #${stop.code}). Route${routeNums.length > 1 ? 's' : ''} ${routeList}, every day of the week.`,
  `Next buses and the full timetable at ${name}, ${system.name}, stop #${stop.code}.`);

const SITE = 'https://transit.shivrajsinh.in';
const path = `bc/${system.slug}/stop/${stop.code}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: REGION.name, item: `${SITE}/${REGION.slug}` },
      { '@type': 'ListItem', position: 2, name: `${system.name} buses`, item: `${SITE}/bc/${system.slug}` },
      { '@type': 'ListItem', position: 3, name, item: `${SITE}/${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BusStop',
    name,
    identifier: stop.code,
    ...(stop.lat ? { geo: { '@type': 'GeoCoordinates', latitude: stop.lat, longitude: stop.lon } } : {}),
    containedInPlace: { '@type': 'City', name: system.name },
  },
];
const cfg = { tz: system.timezone, routes: Object.fromEntries(stop.routes.map((r) => { const x = routeOf(r.route); return [`${r.route}|${r.headsign}`, { days: x?.days.map(({ key, days }) => ({ key, days })) || [], exceptions: x?.exceptions.map(({ date, runs }) => ({ date, runs })) || [] }]; })) };
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} og={system.slug}>
<main class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/bc">{REGION.name}</a> › <a href={`/bc/${system.slug}`}>{system.name}</a>{hub && <> › <a href={`/bc/${system.slug}/hub/${hub.slug}`}>{plain(hub.name)}</a></>} › Stop {stop.code}</nav>
  <div class="page-head">
    <Icon name="map-pin" class="lg" />
    <div>
      <h1>{name}</h1>
      <p class="sub">Stop #{stop.code} · {system.name} · Route{routeNums.length > 1 ? 's' : ''} {routeList}</p>
    </div>
  </div>
  <div class="actions">
    <button class="btn btn-quiet btn-sm" type="button" data-fav={`stop:${system.slug}/${stop.code}`} data-name={name} data-sub={`${system.name} · #${stop.code}`}><Icon name="star" /><span data-fav-label>Save</span></button>
    <button class="btn btn-quiet btn-sm" type="button" data-share><Icon name="share-network" /><span data-share-label>Share</span></button>
    {stop.lat && <a class="btn btn-quiet btn-sm" href={`https://www.google.com/maps/search/?api=1&query=${stop.lat},${stop.lon}`} rel="nofollow"><Icon name="map-trifold" /> Directions</a>}
    {hub && <a class="btn btn-quiet btn-sm" href={`/bc/${system.slug}/hub/${hub.slug}`}><Icon name="bus" /> All {plain(hub.name)} bays</a>}
  </div>

  <div class="board" data-board data-rows="6" style="margin-top:1.4rem" aria-label={`Next scheduled buses at ${name}`}>
    <div class="board-head"><strong>Next buses here</strong><span class="board-clock" data-clock></span></div>
    <ol><li class="empty">Loading the next buses…</li></ol>
    <p class="board-foot">Scheduled times. The first bus of the day leaves at {clockText(firstAll)}.</p>
  </div>

  <Ad />

  {stop.routes.map((r) => { const key = `${r.route}|${r.headsign}`; const route = routeOf(r.route); return (
    <section class="direction stop-route" data-section data-route={key} data-short={r.short || ''} data-color={r.color || ''} data-text={inkFor(r.color)} data-to={toward(r.headsign)} data-url={`/bc/${system.slug}/${r.route}`}>
      <h2><a href={`/bc/${system.slug}/${r.route}`} style="text-decoration:none" aria-label={`${r.short ? `Route ${r.short}` : plain(r.name)} timetable`}><RouteBadge route={{ short: r.short, color: r.color, textColor: route?.textColor }} /></a> {r.short ? `Route ${r.short}` : plain(r.name)} <span class="muted">to {toward(r.headsign)}</span></h2>
      <div class="tabs" role="tablist" aria-label="Day of the week">
        {r.days.filter((d) => r.times[d.key]).map((d, i) => <button type="button" role="tab" data-day={d.key} aria-selected={i === 0 ? 'true' : 'false'}>{d.label}</button>)}
      </div>
      <p class="next-line" aria-live="polite"></p>
      {r.days.filter((d) => r.times[d.key]).map((d, i) => (
        <div class={`panel${i === 0 ? ' on' : ''}`} data-day={d.key} role="tabpanel">
          <h3>{d.label}, {r.times[d.key].length} buses</h3>
          <table class="hours">
            <tbody>
              {byHour(r.times[d.key]).map((h) => (
                <tr><th class={h.pm ? 'pm' : undefined}>{h.label}<span class="sr">{h.pm ? ' pm' : ' am'}</span></th><td>{h.mins.map((m) => <span data-m={m.m}>{m.text}</span>)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}
    </section>
  ); })}

  <p class="small muted" style="margin-top:1.5rem">Read each row as the hour, then the minutes past it: 7 then 05 35 means 7:05 and 7:35. <b>Bold hours are pm.</b> Scheduled times from {system.name}’s official transit data, refreshed {longDate(system.builtOn)}. Not live arrivals.</p>

  {near.length > 0 && (
    <section>
      <h2>Stops nearby</h2>
      <ul class="list">
        {near.map(({ stop: s, m }) => <li><a href={`/bc/${system.slug}/stop/${s.code}`}><Icon name="map-pin" /><span>{plain(s.name)}<span class="meta">#{s.code} · about {Math.max(1, Math.round(m / 80))} min walk ({Math.round(m / 10) * 10} m)</span></span><Icon name="arrow-right" class="go" /></a></li>)}
      </ul>
    </section>
  )}
</main>
<script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />
</Base>
