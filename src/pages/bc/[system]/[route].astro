---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Ad from '../../../components/Ad.astro';
import RouteBadge from '../../../components/RouteBadge.astro';
import { allSystems, stopPageCodes, REGION } from '../../../lib/data.js';
import { clock, clockText, every, shortDate, longDate, routeLabel, runsText, place, plain, slugify } from '../../../lib/format.js';

export function getStaticPaths() {
  return allSystems().flatMap((system) => system.routes.map((route) => ({
    params: { system: system.slug, route: route.slug },
    props: { system, route },
  })));
}

const { system, route } = Astro.props;
const stopPages = stopPageCodes(system.slug);
const label = routeLabel(route);
const name = plain(route.name);
const main = route.days[0];
const mainSummary = route.summary[main.key];

// Titles lead with what riders type: "<town> bus route <n>" (Google autocomplete, Oct 2026).
const fit = (max, ...c) => c.find((s) => s.length <= max) ?? c.at(-1);
const title = route.short
  ? fit(60, `${system.name} Bus Route ${route.short} Schedule: ${name}`, `${system.name} Bus Route ${route.short} Schedule and Map`, `${system.name} Bus Route ${route.short} Schedule`)
  : fit(60, `${name} Bus Schedule (${system.name})`, `${name} Bus Schedule`);
const description = fit(160,
  `${system.name} ${label} ${name} timetable: first bus ${clockText(mainSummary.first)}, last ${clockText(mainSummary.last)} ${main.label}${mainSummary.gap ? `, ${every(mainSummary.gap)}` : ''}. Every stop, both directions, route map.`,
  `${system.name} ${label} timetable: first bus ${clockText(mainSummary.first)}, last ${clockText(mainSummary.last)} ${main.label}. Every stop, both directions.`);

const WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const covered = new Set(route.days.flatMap((d) => d.days));
const missing = WEEKDAYS.filter((_, i) => !covered.has(i));

// Places served: the route's timepoints, which are the stops the operator itself names.
const places = [...new Set(route.directions.flatMap((d) => d.columns.map((c) => place(c.name))))];
const placesText = places.length > 1 ? `${places.slice(0, -1).join(', ')} and ${places.at(-1)}` : places[0];

const dests = route.directions.map((d) => place(d.stops.at(-1).name));
const dirNames = route.directions.map((d, i) => {
  const clash = dests.filter((x) => x === dests[i]).length > 1;
  return clash
    ? { heading: `${label}: ${plain(d.headsign)}`, anchor: slugify(d.headsign) || `direction-${i + 1}` }
    : { heading: `${label} to ${dests[i]}`, anchor: `to-${slugify(dests[i])}` };
});
dirNames.forEach((x, i) => { if (dirNames.findIndex((m) => m.anchor === x.anchor) !== i) x.anchor += `-${i + 1}`; });

const others = system.routes.filter((r) => r.slug !== route.slug);
const holidayList = route.exceptions.filter((e) => e.holiday);
const otherExceptions = route.exceptions.filter((e) => !e.holiday);
const routeColor = route.color || 'var(--ink)';

const SITE = 'https://transit.shivrajsinh.in';
const path = `${REGION.slug}/${system.slug}/${route.slug}`;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: REGION.name, item: `${SITE}/${REGION.slug}` },
    { '@type': 'ListItem', position: 2, name: `${system.name} buses`, item: `${SITE}/${REGION.slug}/${system.slug}` },
    { '@type': 'ListItem', position: 3, name: label, item: `${SITE}/${path}` },
  ],
}];
const cfg = { tz: system.timezone, routes: { [route.slug]: { days: route.days.map(({ key, days }) => ({ key, days })), exceptions: route.exceptions.map(({ date, runs }) => ({ date, runs })) } } };

const faq = [
  [`What time is the first ${label} bus?`, `${route.days.map((d) => route.summary[d.key] && `${d.label}: ${clockText(route.summary[d.key].first)}`).filter(Boolean).join('. ')}.`],
  [`What time is the last ${label} bus?`, `${route.days.map((d) => route.summary[d.key] && `${d.label}: ${clockText(route.summary[d.key].last)}`).filter(Boolean).join('. ')}. A time after midnight belongs to the evening before.`],
  ...(mainSummary.gap ? [[`How often does ${label} run?`, `${route.days.map((d) => route.summary[d.key]?.gap && `${d.label}: ${every(route.summary[d.key].gap)}`).filter(Boolean).join('. ')}, between 7 am and 7 pm.`]] : []),
  [`Does ${label} run on weekends?`, `Saturday: ${covered.has(5) ? 'yes' : 'no service'}. Sunday: ${covered.has(6) ? 'yes' : 'no service'}.`],
  ...(holidayList.length ? [[`Does ${label} run on holidays?`, `${holidayList.map((e) => `${e.holiday} (${shortDate(e.date)}): ${runsText(e, route.days)}`).join('. ')}.`]] : []),
  [`Where does ${label} go?`, `${label} serves ${placesText}. The full list of stops for each direction is below the timetables.`],
  ['Are these live bus times?', `No. They are the published schedule from ${system.name}’s official transit data, refreshed ${longDate(system.builtOn)}. A bus can run early or late, and detours are not shown.`],
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} og={system.slug}>
<main class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/bc">{REGION.name}</a> › <a href={`/bc/${system.slug}`}>{system.name}</a> › {label}</nav>

  <div class="page-head">
    <RouteBadge route={route} lg />
    <div>
      <h1>{system.name} {label}{route.short && name ? <>: {name}</> : null}</h1>
      <p class="sub">Bus schedule and route map · {route.days.map((d) => d.label).join(', ')}</p>
    </div>
  </div>
  <div class="actions">
    <button class="btn btn-quiet btn-sm" type="button" data-fav={`route:${system.slug}/${route.slug}`} data-name={`${system.name} ${label}`} data-sub={name}><Icon name="star" /><span data-fav-label>Save</span></button>
    <button class="btn btn-quiet btn-sm" type="button" data-print><Icon name="printer" /> Print or PDF</button>
    <button class="btn btn-quiet btn-sm" type="button" data-share><Icon name="share-network" /><span data-share-label>Share</span></button>
  </div>

  <p class="lede" style="margin-top:1.2rem">
    {label} serves {placesText}. {main.label} the first bus is at {clockText(mainSummary.first)} and the last at {clockText(mainSummary.last)}{mainSummary.gap ? <>, {every(mainSummary.gap)} during the day</> : null}.
  </p>

  <h2 class="sr">Timetable summary</h2>
  <div class="days">
    {route.days.map((d) => { const s = route.summary[d.key]; return s && (
      <div class="day"><h3>{d.label}</h3><dl><dt>First</dt><dd>{clockText(s.first)}</dd><dt>Last</dt><dd>{clockText(s.last)}</dd><dt>Buses</dt><dd>{s.trips}</dd>{s.gap && <><dt>Daytime</dt><dd>{every(s.gap)}</dd></>}</dl></div>
    ); })}
    {missing.length > 0 && <div class="day"><h3>{missing.join(', ')}</h3><p class="muted" style="margin:0">No service</p></div>}
  </div>

  {(route.exceptions.length > 0 || system.changesOn) && (
    <div class="notice"><Icon name="calendar-check" /><div>
      {holidayList.length > 0 && <p><b>Holidays</b></p>}
      {holidayList.length > 0 && <ul>{holidayList.map((e) => <li>{shortDate(e.date)} ({e.holiday}): {runsText(e, route.days)}</li>)}</ul>}
      {otherExceptions.length > 0 && <p><b>Also different:</b> {otherExceptions.map((e) => `${shortDate(e.date)} (${runsText(e, route.days)})`).join('; ')}.</p>}
      {system.changesOn && <p><b>Timetable change:</b> {system.name}’s timetable changes on {longDate(system.changesOn)}. The times below are for the current timetable.</p>}
    </div></div>
  )}

  {route.directions.map((dir, di) => (
    <>
      <section class="direction" id={dirNames[di].anchor} data-section data-route={route.slug} data-from={place(dir.columns[0].name)}>
        <h2>{dirNames[di].heading}</h2>
        <p class="muted small" style="margin:0">Bus sign “{plain(dir.headsign)}” · from {place(dir.stops[0].name)} · {dir.stops.length} stops</p>
        <div class="tabs" role="tablist" aria-label="Day of the week">
          {route.days.filter((d) => dir.schedules[d.key]).map((d, i) => <button type="button" role="tab" data-day={d.key} aria-selected={i === 0 ? 'true' : 'false'}>{d.label}</button>)}
        </div>
        <p class="next-line" aria-live="polite"></p>
        {route.days.filter((d) => dir.schedules[d.key]).map((d, i) => (
          <div class={`panel${i === 0 ? ' on' : ''}`} data-day={d.key} role="tabpanel">
            <h3>{d.label}</h3>
            <p class="legend">Times at the main stops. <b>Bold is pm.</b> A dot means that trip does not stop there.</p>
            <div class="tt-wrap">
              <table class="tt">
                <thead><tr>{dir.columns.map((c) => <th scope="col">{stopPages.has(c.code) ? <a href={`/bc/${system.slug}/stop/${c.code}`}>{plain(c.name)}</a> : plain(c.name)}</th>)}</tr></thead>
                <tbody>
                  {dir.schedules[d.key].map((row) => (
                    <tr data-m={row[0] ?? ''}>{row.map((m) => {
                      if (m == null) return <td class="no">·</td>;
                      const c = clock(m);
                      return <td class={c.pm ? 'pm' : undefined}>{c.text}</td>;
                    })}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))}
        <details class="stops-detail">
          <summary class="btn btn-quiet btn-sm"><Icon name="path" /> All {dir.stops.length} stops on this direction</summary>
          <ol class="diagram" style={`--route:${routeColor}`}>
            {dir.stops.map((s) => { const tp = dir.columns.some((c) => c.code === s.code); return (
              <li class={tp ? 'tp' : undefined}>{stopPages.has(s.code) ? <a href={`/bc/${system.slug}/stop/${s.code}`}>{plain(s.name)}</a> : plain(s.name)} <small>#{s.code}</small></li>
            ); })}
          </ol>
        </details>
      </section>
      {di === 0 && <Ad />}
    </>
  ))}

  <section>
    <h2>{label} route map</h2>
    <div class="map" data-map={`/geo/${system.slug}/${route.slug}.json`}>
      <button class="map-open" type="button"><Icon name="map-trifold" />Show {label} on a map</button>
    </div>
  </section>

  <section>
    <h2>Questions about {label}</h2>
    <div class="faq">{faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>

  <Ad />

  {others.length > 0 && (
    <section>
      <h2>Other {system.name} routes</h2>
      <div class="list-cols">
        {[others.slice(0, Math.ceil(others.length / 2)), others.slice(Math.ceil(others.length / 2))].map((col) => col.length > 0 && (
          <ul class="list">
            {col.map((r) => <li><a href={`/bc/${system.slug}/${r.slug}`}><RouteBadge route={r} /><span>{plain(r.name || routeLabel(r))}<span class="meta">{r.days.map((d) => d.label).join(', ')}</span></span><Icon name="arrow-right" class="go" /></a></li>)}
          </ul>
        ))}
      </div>
    </section>
  )}
</main>
<script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />
</Base>
