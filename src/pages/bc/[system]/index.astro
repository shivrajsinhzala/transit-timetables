---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Ad from '../../../components/Ad.astro';
import RouteBadge from '../../../components/RouteBadge.astro';
import { allSystems, pageStops, busiestDay, hubs, REGION } from '../../../lib/data.js';
import { clockText, every, shortDate, longDate, routeLabel, plain } from '../../../lib/format.js';

export function getStaticPaths() {
  return allSystems().map((system) => ({ params: { system: system.slug }, props: { system } }));
}

const { system } = Astro.props;
const n = system.routes.length;
const fit = (max, ...c) => c.find((s) => s.length <= max) ?? c.at(-1);
const title = fit(60,
  `${system.name} Bus Routes, Schedules and Map (${n} Route${n === 1 ? '' : 's'})`,
  `${system.name} Bus Routes and Schedules (${n} Routes)`,
  `${system.name} Bus Routes and Schedules`);

const mainOf = (r) => r.summary[r.days[0]?.key];
const frequent = system.routes.filter((r) => { const s = mainOf(r); return s?.gap && s.gap <= 15 && r.days[0].days.length >= 5; });
const others = system.routes.filter((r) => !frequent.includes(r));
const firsts = system.routes.map((r) => mainOf(r)?.first).filter((x) => x != null);
const lasts = system.routes.map((r) => mainOf(r)?.last).filter((x) => x != null);
const sundayRoutes = system.routes.filter((r) => r.days.some((d) => d.days.includes(6))).length;
const holidays = [...new Map(system.routes.flatMap((r) => r.exceptions).filter((e) => e.holiday).map((e) => [e.date, e])).values()].sort((a, b) => a.date.localeCompare(b.date));
const busiest = [...pageStops(system.slug)].sort((a, b) => busiestDay(b) - busiestDay(a)).slice(0, 10);
const hubList = hubs(system.slug).slice(0, 10);
const description = fit(160,
  `All ${n} ${system.name} bus routes with full schedules, a route map and the next bus. First bus ${clockText(Math.min(...firsts))}, last ${clockText(Math.max(...lasts))} on weekdays.`,
  `All ${n} ${system.name} bus routes with full schedules, a route map and the next bus.`);

const faq = [
  [`What time do ${system.name} buses start and stop?`, `On a weekday the earliest route starts at ${clockText(Math.min(...firsts))} and the last bus leaves at ${clockText(Math.max(...lasts))}. Each route page lists its own first and last bus for every day.`],
  [`Do ${system.name} buses run on Sundays?`, sundayRoutes ? `${sundayRoutes} of the ${n} routes run on Sundays. The others do not; their pages say which days they run.` : `No. None of the ${n} routes run on Sundays in the current timetable.`],
  ...(holidays.length ? [[`Do ${system.name} buses run on holidays?`, `${holidays.map((h) => `${h.holiday} (${shortDate(h.date)})`).join(' and ')} run a different timetable on most routes. Each route page says which one.`]] : []),
  [`Is there a ${system.name} bus map?`, 'Yes. Open the map on this page to see every route, and open a route to see its stops on the map.'],
  [`Where do the ${system.name} times come from?`, `From the schedule data BC Transit publishes for ${system.name}, refreshed ${longDate(system.builtOn)}. These are scheduled times, not live arrivals.`],
];

const SITE = 'https://transit.shivrajsinh.in';
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: REGION.name, item: `${SITE}/${REGION.slug}` },
    { '@type': 'ListItem', position: 2, name: `${system.name} buses`, item: `${SITE}/${REGION.slug}/${system.slug}` },
  ],
}];
---
<Base title={title} description={description} path={`bc/${system.slug}`} jsonLd={jsonLd} og={system.slug}>
<main class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/bc">{REGION.name}</a> › {system.name}</nav>
  <h1>{system.name} bus routes and schedules</h1>
  <p class="lede">Timetables for all {n} {system.name} routes, serving {system.area}. Open a route for the whole day in both directions, with the next bus highlighted.</p>
  <div class="actions">
    <button class="btn btn-primary" type="button" data-search-open><Icon name="magnifying-glass" /> Find a route or stop</button>
    <button class="btn btn-quiet" type="button" data-near-me><Icon name="navigation-arrow" /> Stops near me</button>
  </div>

  <section data-saved={`/bc/${system.slug}/`} hidden>
    <h2>Your saved {system.name} stops</h2>
    <ul class="list"></ul>
  </section>

  {(holidays.length > 0 || system.changesOn) && (
    <div class="notice"><Icon name="calendar-check" /><div>
      {holidays.length > 0 && <p><b>Coming up:</b> {holidays.map((e) => `${e.holiday}, ${shortDate(e.date)}`).join(' and ')}. Each route page says which timetable it runs that day.</p>}
      {system.changesOn && <p><b>Timetable change on {longDate(system.changesOn)}.</b> These pages show the current timetable.</p>}
    </div></div>
  )}

  {frequent.length > 0 && (
    <section>
      <h2>Frequent routes</h2>
      <p class="muted">A bus every 15 minutes or better on weekday daytimes.</p>
      <ul class="list">
        {frequent.map((r) => { const s = mainOf(r); return (
          <li><a href={`/bc/${system.slug}/${r.slug}`}><RouteBadge route={r} /><span>{plain(r.name || routeLabel(r))}<span class="meta">{every(s.gap)} · {clockText(s.first)} to {clockText(s.last)}</span></span><Icon name="arrow-right" class="go" /></a></li>
        ); })}
      </ul>
    </section>
  )}

  <section>
    <h2>{frequent.length ? 'All other routes' : 'All routes'}</h2>
    <div class="list-cols">
      {[others.slice(0, Math.ceil(others.length / 2)), others.slice(Math.ceil(others.length / 2))].map((col) => col.length > 0 && (
        <ul class="list">
          {col.map((r) => { const d = r.days[0]; const s = r.summary[d.key]; return (
            <li><a href={`/bc/${system.slug}/${r.slug}`}><RouteBadge route={r} /><span>{plain(r.name || routeLabel(r))}<span class="meta">{r.days.map((x) => x.label).join(', ')}{s && `. From ${clockText(s.first)}`}</span></span><Icon name="arrow-right" class="go" /></a></li>
          ); })}
        </ul>
      ))}
    </div>
  </section>

  <section>
    <h2>{system.name} bus route map</h2>
    <div class="map" data-map={`/geo/${system.slug}.json`}>
      <button class="map-open" type="button"><Icon name="map-trifold" />Show all {n} routes on a map</button>
    </div>
  </section>

  <Ad />

  {hubList.length > 0 && (
    <section>
      <h2>Exchanges and transit hubs</h2>
      <ul class="list">
        {hubList.map((h) => <li><a href={`/bc/${system.slug}/hub/${h.slug}`}><Icon name="bus" /><span>{plain(h.name)}<span class="meta">{h.stops.length} bays · all departures in one place</span></span><Icon name="arrow-right" class="go" /></a></li>)}
      </ul>
    </section>
  )}

  {busiest.length > 0 && (
    <section>
      <h2>Busiest stops</h2>
      <ul class="list">
        {busiest.map((st) => <li><a href={`/bc/${system.slug}/stop/${st.code}`}><Icon name="map-pin" /><span>{plain(st.name)}<span class="meta">Stop #{st.code} · {busiestDay(st)} buses on its busiest day</span></span><Icon name="arrow-right" class="go" /></a></li>)}
      </ul>
    </section>
  )}

  <section>
    <h2>{system.name} bus questions</h2>
    <div class="faq">{faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
  </section>
  <p class="small muted">Schedule as published in {system.name}’s official transit data, refreshed {longDate(system.builtOn)}{system.feed.to ? `; the current data runs to ${longDate(system.feed.to)}` : ''}.</p>
</main>
</Base>
