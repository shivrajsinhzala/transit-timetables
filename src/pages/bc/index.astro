---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SYSTEM_INDEX, REGIONS, getSystem } from '../../lib/data.js';
const routes = SYSTEM_INDEX.reduce((a, s) => a + s.routes, 0);
const colorsOf = (slug) => getSystem(slug).routes.map((r) => r.color).filter(Boolean).slice(0, 8);
---
<Base title={`BC Bus Schedules by Town: ${SYSTEM_INDEX.length} Transit Systems | Stopwatch`} description={`Bus timetables for ${routes} routes in ${SYSTEM_INDEX.length} British Columbia towns, from Victoria and Kelowna to Smithers and Tofino. Pick your town.`} path="bc">
<main class="wrap">
  <nav class="crumbs" aria-label="Breadcrumb">British Columbia</nav>
  <h1>British Columbia bus schedules</h1>
  <p class="lede">{routes} bus routes in {SYSTEM_INDEX.length} towns, built from the official schedule data. Every route shows the whole day and highlights the next bus.</p>
  <div class="actions">
    <button class="btn btn-primary" type="button" data-search-open><Icon name="magnifying-glass" /> Find a route or stop</button>
    <button class="btn btn-quiet" type="button" data-near-me><Icon name="navigation-arrow" /> Stops near me</button>
  </div>
  {REGIONS.map((reg) => (
    <section>
      <h2>{reg.name}</h2>
      <div class="towns" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))">
        {SYSTEM_INDEX.filter((s) => s.region === reg.slug).sort((a, b) => b.routes - a.routes).map((s) => (
          <a class="tile" href={`/bc/${s.slug}`} style="min-height:120px">
            <span class="stripes" aria-hidden="true">{colorsOf(s.slug).map((c) => <i style={`background:${c}`} />)}</span>
            <strong>{s.name}</strong>
            <span>{s.routes} route{s.routes === 1 ? '' : 's'} · {s.area}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</main>
</Base>
