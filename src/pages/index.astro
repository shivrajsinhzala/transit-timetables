---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Ad from '../components/Ad.astro';
import Faq from '../components/Faq.astro';
import RouteBadge from '../components/RouteBadge.astro';
import PopularRoutes from '../components/PopularRoutes.astro';
import { SYSTEM_INDEX, countries, getSystem } from '../lib/data.js';
import { clock, shortDate, place, plain, sharedMode, plural } from '../lib/format.js';
import { FEATURED } from '../lib/featured.js';

const routes = SYSTEM_INDEX.reduce((a, s) => a + s.routes, 0);
const stops = SYSTEM_INDEX.reduce((a, s) => a + s.stops, 0);
const systems = SYSTEM_INDEX.length;
const all = countries();
const nf = (n) => n.toLocaleString('en');

// Country tiles: counts and the three biggest systems in each.
const tiles = all.map((c) => {
  const list = [...c.systems].sort((a, b) => b.routes - a.routes);
  return { cc: c.cc, name: c.name, word: c.word, systems: list.length, routes: list.reduce((a, s) => a + s.routes, 0), top: list.slice(0, 3).map((s) => s.name) };
}).sort((a, b) => b.routes - a.routes);

// The biggest networks, each with its own colours.
const big = [...SYSTEM_INDEX].sort((a, b) => b.routes - a.routes).slice(0, 8).map((s) => {
  const sys = getSystem(s.key);
  return { key: s.key, name: s.name, area: s.area, routes: s.routes, country: all.find((c) => c.cc === s.cc)?.name, mode: sharedMode(sys.routes, sys), colors: sys.routes.map((r) => r.color).filter(Boolean).slice(0, 10) };
});

// A real excerpt for the "whole day" preview: Kelowna Route 8's first weekday departures.
const kelowna = getSystem('ca/kelowna');
const r8 = kelowna?.routes.find((r) => r.slug === 'route-8');
const r8dir = r8?.directions[0];
const r8key = r8?.days[0].key;
const previewCols = r8dir ? r8dir.columns.slice(0, 4) : [];
const previewRows = r8dir ? r8dir.schedules[r8key].filter((row) => row[0] != null).slice(0, 6).map((row) => row.slice(0, 4)) : [];

// A real holiday line for the "holidays" preview, from Dublin Bus if it has one coming up.
const holidaySys = ['ie/dublin-bus', 'ca/kelowna', 'uk/brighton-hove-bus'].map(getSystem).find((s) => s?.routes.some((r) => r.exceptions.some((e) => e.holiday)));
const holidayRoute = holidaySys?.routes.find((r) => r.exceptions.some((e) => e.holiday));
const holiday = holidayRoute?.exceptions.find((e) => e.holiday);
const runsLabel = holiday ? (holidayRoute.days.find((d) => d.key === holiday.runs)?.label || 'a special') : '';

const boards = FEATURED.map((f) => ({ key: f.key, city: f.city, tz: f.tz, src: `/boards/${f.key.replace('/', '-')}.json` }));
const countryList = `${all.slice(0, -1).map((c) => c.name).join(', ')} and ${all.at(-1).name}`;

const faq = [
  ['What is Stopwatch?', `Stopwatch is a free, independent website with the full timetable for ${nf(routes)} bus, tram, train and ferry routes from ${systems} transit systems in ${countryList}. Every route and stop page highlights the next scheduled departure, and pages work offline once opened.`],
  ['Is Stopwatch an official transit site?', 'No. Stopwatch is independent. It is built from the open timetable data that operators and transport authorities publish, and each page names its source. For fares, disruptions and service alerts, use the operator’s own channels.'],
  ['Are these live times?', 'They are the published timetable. The next departure is worked out from that timetable and your phone’s clock, so a bus running late will not show as late.'],
  ['Which cities are covered?', `${systems} systems including Toronto, Melbourne, Dublin, Phoenix, Victoria, Kelowna, Brighton, Oxford, Nottingham, Cardiff and Dunedin. Pick a country below to see them all.`],
  ['Does it work without signal?', 'Yes, for timetables you have opened before on this phone. Add Stopwatch to your home screen and they open like an app.'],
  ['How often are the timetables updated?', 'Every week, from the data each operator publishes. Each page says when its timetable was last refreshed.'],
];
---
<Base title="Stopwatch: Bus, Tram and Train Timetables in 6 Countries" description={`Full timetables for ${nf(routes)} routes from ${systems} transit systems in ${countryList}, with the next departure first. No app needed.`} path="" speakable={['.hero h1', '.hero .lede']}>
<main class="wrap" style="padding-top:0">
  <section class="hero">
    <div>
      <h1>Every bus, tram and train, <em>on the clock</em>.</h1>
      <p class="lede">Full timetables for {nf(routes)} routes and {nf(stops)} stops in {systems} transit systems across {all.length} countries, with your next departure first. No app, no PDF, works offline.</p>
      <button class="hero-search" type="button" data-search-open>
        <Icon name="magnifying-glass" /><span>Route, stop or town</span><span class="btn btn-primary btn-sm">Search</span>
      </button>
      <div class="actions">
        <button class="btn btn-quiet" type="button" data-near-me><Icon name="navigation-arrow" /> Stops near me</button>
      </div>
    </div>
    <div>
      <div class="board" data-board data-rows="6" data-boards={JSON.stringify(boards)} aria-label="Next scheduled departures">
        <div class="board-head"><strong><a data-board-name href={`/${boards[0].key}`}>{boards[0].city}</a></strong><span class="board-clock" data-clock></span></div>
        <ol><li class="empty">Loading the next departures…</li></ol>
        <p class="board-foot" data-board-foot>Scheduled departures, from the published timetable.</p>
      </div>
      <div class="cities" role="group" aria-label="Show departures in another city">
        {boards.map((b, i) => <button type="button" class="city" data-city={b.key} aria-pressed={i === 0 ? 'true' : 'false'}>{b.city}</button>)}
      </div>
    </div>
  </section>

  <section data-saved="" hidden>
    <h2>Your saved stops</h2>
    <ul class="list"></ul>
  </section>

  <section class="reveal" id="countries">
    <h2>Pick your country</h2>
    <div class="countries">
      {tiles.map((c) => (
        <a class="country" href={`/${c.cc}`}>
          <span class="cc" aria-hidden="true">{c.cc.toUpperCase()}</span>
          <strong>{c.name}</strong>
          <span>{`${c.systems} system${c.systems === 1 ? '' : 's'} · ${nf(c.routes)} routes`}</span>
          <small>{c.top.join(', ')}</small>
        </a>
      ))}
    </div>
  </section>

  <section class="reveal">
    <h2>The biggest networks</h2>
    <div class="towns">
      {big.map((t) => (
        <a class="tile" href={`/${t.key}`}>
          <span class="stripes" aria-hidden="true">{t.colors.map((col) => <i style={`background:${col}`} />)}</span>
          <strong>{t.name}</strong>
          <span>{`${t.routes} ${t.mode === 'transit' ? '' : `${t.mode} `}routes · ${t.country}`}</span>
        </a>
      ))}
    </div>
  </section>

  <PopularRoutes title="Popular routes" keys={FEATURED.map((f) => f.key)} />

  <Ad />

  {r8 && (
    <section class="feature reveal">
      <div>
        <h2>The whole day, on one screen</h2>
        <p>Every departure for every route, laid out like the printed timetable at the stop, but readable on a phone. The departure you can still catch is highlighted.</p>
        <a class="btn btn-quiet" href="/ca/kelowna/route-8">See Kelowna Route 8 <Icon name="arrow-right" /></a>
      </div>
      <div class="preview" aria-label="Excerpt from the Kelowna Route 8 timetable">
        <p class="small muted" style="margin:0 0 .6rem;display:flex;gap:.5rem;align-items:center"><RouteBadge route={r8} /> {plain(r8.name)}, {r8.days[0].label}</p>
        <div class="tt-wrap" style="margin:0;max-height:none">
          <table class="tt">
            <thead><tr>{previewCols.map((c) => <th scope="col">{place(c.name)}</th>)}</tr></thead>
            <tbody>{previewRows.map((row) => <tr>{row.map((m) => m == null ? <td class="no">·</td> : <td class={clock(m).pm ? 'pm' : undefined}>{clock(m).text}</td>)}</tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {holiday && (
    <section class="feature flip reveal">
      <div>
        <h2>It knows tomorrow is a holiday</h2>
        <p>Public holidays and one-off days are read from each country’s calendar and the timetable itself, so every route says what it really runs that day instead of a generic warning.</p>
      </div>
      <div class="preview">
        <div class="notice" style="margin:0"><Icon name="calendar-check" /><p><b>{holiday.holiday}, {shortDate(holiday.date)}:</b> {holidaySys.name} Route {holidayRoute.short} runs the {runsLabel} timetable.</p></div>
      </div>
    </section>
  )}

  <section class="band reveal">
    <h2>Built for standing at the stop</h2>
    <p>Fast on a weak signal, no account, nothing to install.</p>
    <div class="band-points">
      <div><Icon name="wifi-slash" /><p><strong>Works offline</strong><span>Timetables you have opened stay on your phone.</span></p></div>
      <div><Icon name="star" /><p><strong>Save your stops</strong><span>Your regular stops, one tap from the home page.</span></p></div>
      <div><Icon name="navigation-arrow" /><p><strong>Stops near me</strong><span>Your location stays in your browser.</span></p></div>
      <div><Icon name="printer" /><p><strong>Print any timetable</strong><span>Or save it as a PDF for the fridge.</span></p></div>
    </div>
  </section>

  <div class="reveal"><Faq items={faq} title="Questions about Stopwatch" /></div>
</main>
</Base>
