---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Ad from '../components/Ad.astro';
import RouteBadge from '../components/RouteBadge.astro';
import { SYSTEM_INDEX, REGIONS, getSystem, pageStops, busiestDay } from '../lib/data.js';
import { inkFor, clock, shortDate, place, plain } from '../lib/format.js';

const routes = SYSTEM_INDEX.reduce((a, s) => a + s.routes, 0);
const towns = SYSTEM_INDEX.length;

// The board: the busiest stop in the province's busiest system, with real scheduled times.
const victoria = getSystem('victoria');
const featured = [...pageStops('victoria')].sort((a, b) => busiestDay(b) - busiestDay(a))[0];
const boardData = {
  tz: victoria.timezone,
  rows: featured.routes.map((r) => {
    const route = victoria.routes.find((x) => x.slug === r.route);
    return {
      short: r.short, color: r.color, text: inkFor(r.color), to: place(r.headsign.replace(/^.*-\s*To\s+/i, '').replace(/^To\s+/i, '')),
      url: `/bc/victoria/${r.route}`,
      days: route?.days.map(({ key, days }) => ({ key, days })) || [],
      exceptions: route?.exceptions.map(({ date, runs }) => ({ date, runs })) || [],
      times: r.times,
    };
  }),
};

const TILE_ORDER = ['victoria', 'kelowna', 'fraser-valley', 'kamloops', 'nanaimo'];
const tiles = TILE_ORDER.map((slug) => {
  const sys = getSystem(slug);
  return { slug, name: sys.name, area: sys.area, routes: sys.routes.length, colors: sys.routes.map((r) => r.color).filter(Boolean).slice(0, 10) };
});

// A real excerpt for the "whole day" preview: Kelowna Route 8's first weekday departures.
const kelowna = getSystem('kelowna');
const r8 = kelowna.routes.find((r) => r.slug === 'route-8');
const r8dir = r8.directions[0];
const r8key = r8.days[0].key;
const previewCols = r8dir.columns.slice(0, 4);
const previewRows = r8dir.schedules[r8key].filter((row) => row[0] != null).slice(0, 6).map((row) => row.slice(0, 4));

// A real holiday line for the "holidays" preview.
const holidayRoute = kelowna.routes.find((r) => r.exceptions.some((e) => e.holiday));
const holiday = holidayRoute?.exceptions.find((e) => e.holiday);
const runsLabel = holiday ? (holidayRoute.days.find((d) => d.key === holiday.runs)?.label || 'a special') : '';

const SITE = 'https://transit.shivrajsinh.in';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Stopwatch', url: SITE, description: `Bus timetables for ${routes} routes in ${towns} British Columbia towns.` },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Stopwatch', url: SITE, logo: `${SITE}/icon-512.png` },
];
const faq = [
  ['Is Stopwatch the official BC Transit site?', 'No. Stopwatch is an independent site built from BC Transit’s open schedule data. For fares, detours and service alerts, use BC Transit’s own channels.'],
  ['Are these live bus times?', 'They are the published schedule. The next bus is worked out from that schedule and your phone’s clock, so a bus running late will not show as late.'],
  ['How do I find my stop number?', 'It is on the sign at the stop. Type it into search, or tap Stops near me to see the closest stops with their numbers.'],
  ['Does it work without signal?', 'Yes, for timetables you have opened before on this phone. Add Stopwatch to your home screen and they open like an app.'],
  ['How often are the timetables updated?', 'Every week, from the data BC Transit publishes. Each page says when its timetable was last refreshed.'],
];
---
<Base title="Stopwatch: BC Bus Schedules, Routes and Maps" description={`Full bus timetables for ${routes} routes in ${towns} BC towns, with the next bus first. Victoria, Kelowna, Kamloops, Nanaimo and more. No app needed.`} path="" jsonLd={jsonLd}>
<main class="wrap" style="padding-top:0">
  <section class="hero">
    <div>
      <h1>Every BC bus, <em>on the clock</em>.</h1>
      <p class="lede">Full timetables for {routes} routes in {towns} towns, with your next bus first. No app, no PDF, works offline.</p>
      <button class="hero-search" type="button" data-search-open>
        <Icon name="magnifying-glass" /><span>Route, stop or town</span><span class="btn btn-primary btn-sm">Search</span>
      </button>
      <div class="actions">
        <button class="btn btn-quiet" type="button" data-near-me><Icon name="navigation-arrow" /> Stops near me</button>
      </div>
    </div>
    <div class="board" data-board data-rows="6" aria-label={`Next scheduled buses at ${featured.name}`}>
      <div class="board-head"><strong><a href={`/bc/victoria/stop/${featured.code}`}>{place(featured.name)}</a></strong><span class="board-clock" data-clock></span></div>
      <ol><li class="empty">Loading the next buses…</li></ol>
      <p class="board-foot">Scheduled departures in Victoria, from the published timetable.</p>
      <script type="application/json" set:html={JSON.stringify(boardData)} />
    </div>
  </section>

  <section data-saved="" hidden>
    <h2>Your saved stops</h2>
    <ul class="list"></ul>
  </section>

  <section class="reveal">
    <h2>Find your town</h2>
    <div class="towns">
      {tiles.map((t) => (
        <a class="tile" href={`/bc/${t.slug}`}>
          <span class="stripes" aria-hidden="true">{t.colors.map((c) => <i style={`background:${c}`} />)}</span>
          <strong>{t.name}</strong>
          <span>{t.routes} routes · {t.area}</span>
        </a>
      ))}
    </div>
    <div class="regions">
      {REGIONS.map((reg) => (
        <div>
          <h3>{reg.name}</h3>
          <ul>{SYSTEM_INDEX.filter((s) => s.region === reg.slug).sort((a, b) => b.routes - a.routes).map((s) => <li><a href={`/bc/${s.slug}`}>{s.name}<small>{s.routes}</small></a></li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <Ad />

  <section class="feature reveal">
    <div>
      <h2>The whole day, on one screen</h2>
      <p>Every departure for every route, laid out like the printed timetable at the stop, but readable on a phone. The bus you can still catch is highlighted.</p>
      <a class="btn btn-quiet" href="/bc/kelowna/route-8">See Kelowna Route 8 <Icon name="arrow-right" /></a>
    </div>
    <div class="preview" aria-label="Excerpt from the Kelowna Route 8 timetable">
      <p class="small muted" style="margin:0 0 .6rem;display:flex;gap:.5rem;align-items:center"><RouteBadge route={r8} /> {plain(r8.name)}, {r8.days[0].label}</p>
      <div class="tt-wrap" style="margin:0;max-height:none">
        <table class="tt">
          <thead><tr>{previewCols.map((c) => <th scope="col">{place(c.name)}</th>)}</tr></thead>
          <tbody>{previewRows.map((row) => <tr>{row.map((m) => m == null ? <td class="no">·</td> : <td class={clock(m).pm ? 'pm' : undefined}>{clock(m).text}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  {holiday && (
    <section class="feature flip reveal">
      <div>
        <h2>It knows tomorrow is a holiday</h2>
        <p>Stat holidays and one-off days are read from the schedule itself, so each route says what it really runs that day instead of a generic warning.</p>
      </div>
      <div class="preview">
        <div class="notice" style="margin:0"><Icon name="calendar-check" /><p><b>{holiday.holiday}, {shortDate(holiday.date)}:</b> Kelowna Route {holidayRoute.short} runs the {runsLabel} timetable.</p></div>
      </div>
    </section>
  )}

  <section class="band reveal">
    <h2>Built for standing at the stop</h2>
    <p>Fast on a weak signal, no account, nothing to install.</p>
    <div class="band-points">
      <div><Icon name="wifi-slash" /><p><strong>Works offline</strong><span>Timetables you have opened stay on your phone.</span></p></div>
      <div><Icon name="star" /><p><strong>Save your stops</strong><span>Your regular stops, one tap from the home page.</span></p></div>
      <div><Icon name="navigation-arrow" /><p><strong>Stops near me</strong><span>Your location stays in your browser.</span></p></div>
      <div><Icon name="printer" /><p><strong>Print any timetable</strong><span>Or save it as a PDF for the fridge.</span></p></div>
    </div>
  </section>

  <section class="reveal">
    <h2>Questions</h2>
    <div class="faq">
      {faq.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>
</main>
</Base>
