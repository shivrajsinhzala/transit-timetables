---
/**
 * /embed?s=<cc>/<system>/stop/<code>: next departures at one stop, for other websites to put in
 * an iframe (the stop page gives the code). One page for every stop: src/scripts/embed.js reads
 * the stop page and works the times out in the visitor's browser. No ads: AdSense does not allow
 * its ads inside frames on other people's sites. Not indexed; the links open Stopwatch.
 */
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Next departures · Stopwatch</title>
  <base target="_blank" />
  <style is:global>
    :root { --bg: #ffffff; --ink: #15171a; --ink-3: #626870; --line: #dde0e4; --accent: #f2a516; --link: #9a5600; color-scheme: light dark; }
    @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg: #121416; --ink: #eef0f2; --ink-3: #959ba2; --line: #262a2f; --link: #ffc042; } }
    :root[data-theme="dark"] { --bg: #121416; --ink: #eef0f2; --ink-3: #959ba2; --line: #262a2f; --link: #ffc042; }
    * { box-sizing: border-box; }
    html, body { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.35 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; }
    .board { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    .head { display: flex; justify-content: space-between; align-items: baseline; gap: .6rem; padding: .7rem .9rem; border-bottom: 1px solid var(--line); }
    .head a { color: var(--ink); font-weight: 700; text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .head a:hover { text-decoration: underline; }
    .clock { font: 600 .9rem ui-monospace, Menlo, Consolas, monospace; color: var(--ink-3); flex: none; }
    ol { list-style: none; margin: 0; padding: 0; }
    li { display: grid; grid-template-columns: auto 1fr auto; gap: .7rem; align-items: center; padding: .55rem .9rem; border-bottom: 1px solid var(--line); }
    li.empty { display: block; color: var(--ink-3); }
    .badge { min-width: 2.4rem; padding: .15rem .4rem; border-radius: 6px; background: var(--ink); color: var(--bg); font-weight: 800; text-align: center; font-size: .9rem; }
    .to { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    time { font: 700 1rem ui-monospace, Menlo, Consolas, monospace; text-align: right; }
    time small { display: block; font: 500 .75rem -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; color: var(--ink-3); }
    .foot { display: flex; justify-content: space-between; gap: .6rem; padding: .55rem .9rem; font-size: .78rem; color: var(--ink-3); }
    .foot a { color: var(--link); font-weight: 600; }
  </style>
</head>
<body>
  <div class="board" id="board">
    <div class="head"><a data-name href="https://transit.shivrajsinh.in/">Next departures</a><span class="clock" data-clock></span></div>
    <ol><li class="empty">Loading the next departures…</li></ol>
    <div class="foot"><span>Scheduled times, not live</span><a data-full href="https://transit.shivrajsinh.in/">Full timetable on Stopwatch</a></div>
  </div>
  <script>import '../scripts/embed.js';</script>
</body>
</html>
