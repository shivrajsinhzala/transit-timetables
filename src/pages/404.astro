---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found | Stopwatch" description="This page does not exist. Search for your route, stop or town instead." path="404" noindex>
<main class="wrap">
  <section class="nis">
    <div class="led" aria-hidden="true">NOT IN SERVICE</div>
    <h1>That page isn't here</h1>
    <p class="lede">The route may have been renumbered or withdrawn, or the stop retired. Search for it, or start from a country.</p>
    <div class="actions" style="justify-content:center">
      <button class="btn btn-primary" type="button" data-search-open><Icon name="magnifying-glass" /> Search routes and stops</button>
      <button class="btn btn-outline" type="button" data-near-me><Icon name="crosshair-amber" /> Stops near me</button>
      <a class="btn" href="/#countries">All countries <Icon name="arrow-right" /></a>
    </div>
  </section>
</main>
</Base>
