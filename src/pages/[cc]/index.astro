---
import { SITE } from '../../lib/site.js';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Ad from '../../components/Ad.astro';
import Faq from '../../components/Faq.astro';
import Crumbs from '../../components/Crumbs.astro';
import Flag from '../../components/Flag.astro';
import RouteBadge from '../../components/RouteBadge.astro';
import { isMain, countries, GROUPS, getSystem, busiestRoutes } from '../../lib/data.js';
import { sharedMode, modeName, cap, plain, routeLabel, every } from '../../lib/format.js';
import { dateFor, LANG } from '../../lib/page.js';

export function getStaticPaths() {
  return isMain ? countries().map((c) => ({ params: { cc: c.cc }, props: { c } })) : [];
}

const { c } = Astro.props;
const systems = [...c.systems].sort((a, b) => b.routes - a.routes);
const routes = systems.reduce((a, s) => a + s.routes, 0);
const stops = systems.reduce((a, s) => a + s.stops, 0);
const builtOn = systems.map((s) => s.builtOn).sort().at(-1);
// Colour stripes and the mode for each tile, read from the built systems (one file each).
const modeCount = new Map();
// Public holidays in the calendar data, with the systems that change their timetable for each.
const holidayMap = new Map();
const info = Object.fromEntries(systems.map((s) => {
  const sys = getSystem(s.key);
  for (const e of sys.exceptions || []) {
    if (!e.holiday || e.date < sys.builtOn) continue;
    const k = `${e.date}|${e.holiday}`;
    if (!holidayMap.has(k)) holidayMap.set(k, { date: e.date, name: e.holiday, systems: [], none: [] });
    const h = holidayMap.get(k);
    h.systems.push(s.name);
    if (e.runs === 'none') h.none.push(s.name);
  }
  for (const r of sys.routes) { const m = modeName(r.type, sys); modeCount.set(m, (modeCount.get(m) || 0) + 1); }
  return [s.key, { colors: sys.routes.map((r) => r.color).filter(Boolean).slice(0, 8), mode: sharedMode(sys.routes, sys) }];
}));
// "bus, streetcar and subway": the modes in this country, commonest first.
const modes = [...modeCount.entries()].sort((a, b) => b[1] - a[1]).map(([k]) => k);
const andList = (m) => (m.length > 1 ? `${m.slice(0, -1).join(', ')} and ${m.at(-1)}` : m[0]);
const modeList = andList(modes);
// Titles and the h1 carry the three commonest modes, as riders search ("australia bus, train and
// tram timetables"); the full list stays in the description and lede.
const modeShort = andList(modes.slice(0, 3));
// "in the United Kingdom", and the "UK" riders type in titles.
const inName = /^United /.test(c.name) ? `the ${c.name}` : c.name;
const short = { uk: 'UK', us: 'US' }[c.cc] || c.name;
const fit = (max, ...t) => t.find((x) => x.length <= max) ?? t.at(-1);
const regions = Object.entries(c.regions).map(([slug, name]) => ({ slug, name, systems: systems.filter((s) => s.region === slug) })).filter((r) => r.systems.length);
// British Columbia is big enough to group by part of the province.
const sections = regions.flatMap((r) => {
  const groups = [...new Set(r.systems.map((s) => s.group).filter(Boolean))];
  if (!groups.length) return [{ id: r.slug, name: r.name, systems: r.systems }];
  return groups.map((g) => ({ id: `${r.slug}-${g}`, name: `${GROUPS[g]}`, region: r.name, systems: r.systems.filter((s) => s.group === g) }));
});
const top = systems.slice(0, 4).map((s) => s.name);
const W = cap(c.word);
const titleCase = (x) => x.replace(/\b(?!and\b)[a-z]/g, (ch) => ch.toUpperCase());
const title = fit(60, `${short} ${titleCase(modeShort)} ${W}s | Stopwatch`, `${short} ${titleCase(modes[0])} ${W}s | Stopwatch`);
const description = fit(155,
  ...[3, 2, 1].map((n) => `${W}s for ${routes.toLocaleString('en')} ${modeList} routes from ${systems.length} transit systems in ${inName}, including ${andList(top.slice(0, n))}. Next departure first.`),
  `${W}s for ${routes.toLocaleString('en')} ${modeShort} routes from ${systems.length} transit systems in ${inName}, with the next departure first.`);
const holidays = [...holidayMap.values()].sort((x, y) => x.date.localeCompare(y.date)).slice(0, 5);
const listOf = (names) => (names.length > 4 ? `${names.slice(0, 3).join(', ')} and ${names.length - 3} more` : andList(names));
const faq = [
  [`Which transit systems in ${inName} does Stopwatch cover?`, `${systems.length} systems with ${routes.toLocaleString('en')} routes and ${stops.toLocaleString('en')} stops, from ${top.join(', ')} to ${systems.at(-1).name}. Each one has its own page with every route, a map and the busiest stops.`],
  [`Where do the ${short} ${c.word}s come from?`, `From open ${c.word} data (GTFS) that the operators and transport authorities publish under open licences. Every page names its source and licence, and the data was last refreshed on ${dateFor(builtOn, c.cc)}.`],
  [`Are these live times?`, `No. Stopwatch shows the published ${c.word} and works out the next departure from it and your phone's clock. For disruptions, check the operator.`],
  [`Is my area missing?`, `Stopwatch only publishes ${c.word}s whose data licence allows it. More systems are added as their data is checked.`],
];

// ---- redesign ----
const initials = (nm) => nm.replace(/[^A-Za-z0-9 ]/g, ' ').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const MON = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const popular = systems.slice(0, 4).flatMap((s) => busiestRoutes(s.key, 2).map(({ route, url }) => {
  const sys = getSystem(s.key);
  const sm = route.summary[route.days[0].key];
  return { route, url, name: `${sys.name} ${routeLabel(route)}`, sub: [plain(route.name) && plain(route.name) !== routeLabel(route) ? plain(route.name) : '', sm?.gap ? every(sm.gap) : ''].filter(Boolean).join(' · ') };
}));
const regionTabs = sections.length > 1 ? sections : [];

---
<Base title={title} description={description} path={c.cc} pageType="CollectionPage" lang={LANG[c.cc]} cc={c.cc} speakable={['.lede', '.faq .answer']} jsonLd={[{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Stopwatch', item: `${SITE}/` }, { '@type': 'ListItem', position: 2, name: c.name, item: `${SITE}/${c.cc}` }] }]}>
<main class="wrap">
  <Crumbs items={[{ name: 'Home', href: '/' }, { name: c.name }]} />
  <section class="sys-hero in" style="gap:28px 48px;padding-top:26px">
    <Flag cc={c.cc} w={200} h={100} class="big-flag" alt={`Flag of ${inName}`} />
    <div class="copy">
      <h1>{c.name} {modeShort} {c.word}s</h1>
      <p class="lede">Stopwatch has full {c.word}s for {systems.length} transit systems in {inName}: {routes.toLocaleString('en')} {modeList} routes and {stops.toLocaleString('en')} stops, built from the operators' open data and refreshed every week (last on {dateFor(builtOn, c.cc)}). Times use the {c.h24 ? '24-hour clock' : '12-hour clock (am/pm)'}.</p>
      <div class="hero-search" style="max-width:620px">
        <button class="hero-field" type="button" data-search-open style="height:56px;font-size:16px"><Icon name="magnifying-glass" class="mag" /><span>Search {short}: route, stop or town</span></button>
        <button class="btn btn-primary" type="button" data-near-me style="height:56px"><Icon name="navigation-arrow" /> Near me</button>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="reg-h" style="padding-top:40px">
    <div class="sec-head reveal">
      <h2 id="reg-h">Transit systems by region</h2>
      {regionTabs.length > 0 && (
        <div class="seg region-tabs js-only" role="group" aria-label="Region">
          <button type="button" data-region="" aria-pressed="true">All</button>
          {regionTabs.map((sec) => <button type="button" data-region={sec.id} aria-pressed="false">{sec.name}</button>)}
        </div>
      )}
    </div>
    {sections.map((sec, i) => (
      <>
        <div class="region" id={sec.id} data-region-box={sec.id}>
          {sections.length > 1 && <h3>{sec.name}{sec.region && sec.region !== c.name && <span class="muted" style="font-weight:600"> · {sec.region}</span>}</h3>}
          <ul class="sys-list">
            {sec.systems.map((s) => (
              <li><a class="scard card" href={`/${s.key}`}>
                <span class="mark">{initials(s.name)}</span>
                <span class="t">{s.name}<small>{s.area}</small></span>
                <span class="n">{s.routes} {s.routes === 1 ? 'route' : 'routes'}</span>
              </a></li>
            ))}
          </ul>
        </div>
        {i === 0 && sections.length > 2 && <Ad />}
      </>
    ))}
  </section>

  {sections.length <= 2 && <Ad />}

  <section class="sec twocol">
    {holidays.length > 0 && (
      <div class="navy-box reveal" role="region" aria-labelledby="hol-h">
        <h2 id="hol-h">Public holidays coming up</h2>
        <p>Most operators run a Sunday or special {c.word}. Each route page says what it runs that day.</p>
        <ul class="hol">
          {holidays.map((h) => (
            <li><span class="cal"><b>{h.date.slice(8, 10)}</b><small>{MON[Number(h.date.slice(5, 7)) - 1]}</small></span>
              <span style="flex:1"><strong>{h.name}</strong><span>{h.none.length === h.systems.length ? `No service on ${listOf(h.none)}` : `A different ${c.word} on ${listOf(h.systems)}${h.none.length ? `; no service on ${listOf(h.none)}` : ''}`}</span></span></li>
          ))}
        </ul>
      </div>
    )}
    <div class="reveal" role="region" aria-labelledby="how-h">
      <h2 id="how-h" style="font-size:30px;margin-bottom:14px">How to read these {c.word}s</h2>
      <ol class="howto">
        <li><span class="num">01</span><Icon name="arrows-left-right" /><h3>Pick the direction</h3><p>Choose the way you're travelling, then the day: weekdays, Saturday or Sunday.</p></li>
        <li><span class="num">02</span><Icon name="map-pin" /><h3>Find your stop</h3><p>On a phone, pick your stop and see its times hour by hour. A dash means that trip does not stop there.</p></li>
        <li><span class="num">03</span><Icon name="clock" /><h3>{c.h24 ? 'Read 24-hour times' : 'Read am and pm'}</h3><p>{c.h24 ? '17:05 is 5:05 in the afternoon.' : 'Every time says am or pm.'} Times after midnight belong to the evening before.</p></li>
        <li><span class="num">04</span><Icon name="star" /><h3>Amber means next</h3><p>The next departure is highlighted, worked out from the published {c.word} and your phone's clock. Past times fade back.</p></li>
      </ol>
    </div>
  </section>

  {popular.length > 0 && (
    <section class="sec reveal" aria-labelledby="pop-h">
      <h2 id="pop-h" style="font-size:30px;margin-bottom:14px">Popular routes in {inName}</h2>
      <ul class="rgrid" style="grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),1fr))">
        {popular.map((p) => <li><a class="rcard card" href={p.url}><RouteBadge route={p.route} size="md" /><span class="t">{p.name}<small>{p.sub}</small></span></a></li>)}
      </ul>
    </section>
  )}

  <Faq items={faq} title={`${short} ${c.word} questions`} ld={false} />
</main>
</Base>
