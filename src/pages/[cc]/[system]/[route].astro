---
import { SITE } from '../../../lib/site.js';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Ad from '../../../components/Ad.astro';
import RouteBadge from '../../../components/RouteBadge.astro';
import Faq from '../../../components/Faq.astro';
import Source from '../../../components/Source.astro';
import Crumbs from '../../../components/Crumbs.astro';
import { shardSystems, pageStops, linkedStopCodes, routeJourneys, routeEnds, pairDaily, mainRouteOf, routeConnections } from '../../../lib/data.js';
import { routeIntro } from '../../../lib/routecopy.js';
import { clock, every, shortDate, routeLabel, runsText, place, plain, slugify, possessive, modeName, vehicle, plural, brandFor, cap, stopWord, inkFor, badgeBg } from '../../../lib/format.js';
import { ctxFor, dateFor } from '../../../lib/page.js';
import { duration } from '../../../lib/journey.js';

export function getStaticPaths() {
  return shardSystems().flatMap((system) => system.routes.map((route) => ({
    params: { cc: system.cc, system: system.slug, route: route.slug },
    props: { system, route },
  })));
}

const { system, route } = Astro.props;
const x = ctxFor(system);
const { t, base, h24, Word, word } = x;
const stopPages = linkedStopCodes(system.key);
const label = routeLabel(route);
const longName = plain(route.name);
// The long name is a subtitle only when it adds something ("Line 1 (Yonge-University)" already says Line 1).
const name = longName && !longName.toLowerCase().includes(label.toLowerCase()) && longName !== label ? longName : '';
const main = route.days[0];
const mainSummary = route.summary[main.key];
const m = modeName(route.type, system);
const v = vehicle(route.type, system);
const vs = plural(v);
const brand = brandFor(system, route.type);
const stopW = stopWord([route.type], system);
const lineWord = /train|subway/.test(m) ? 'line' : 'route';

// Titles lead with what riders type: "<town> bus route <n>", "dublin bus 46a timetable".
const fit = (max, ...c) => c.find((s) => s.length <= max) ?? c.at(-1);
const head = route.label ? `${brand}: ${label}` : `${brand} ${label}`;
// Riders type the number and the places ("201 bus timetable leeds", "tram 96 timetable", "813 bus
// timetable to waverley gardens"), rarely the operator's name: a numbered route's title and h1
// lead with "<n> <Vehicle> <Word>", then where it goes, and the operator only when it fits.
// Numbered routes that share their number in a system ("1" in Moe and in Seymour) are labelled by
// their long name (src/lib/data.js): their titles still lead with the number riders type.
const sharedNum = Boolean(route.label) && /\d/.test(route.short || '') && Boolean(longName);
const num = /\d/.test(route.short || '') && (label === `Route ${route.short}` || sharedNum) ? `${route.short} ${cap(vehicle(route.type, system))}` : '';
const sub = name || (sharedNum ? longName : '');
// "Dandenong - Brandon Park" reads as a search does: "Dandenong to Brandon Park". A feed with no
// route name gets the towns at the ends of its longest journey instead.
const ends = routeEnds(system.key, route.slug);
// "Dublin - Airport - Drogheda" is "Dublin to Drogheda via Airport" (titles drop the "via" when short of room).
const toName = (s) => {
  const [, ends, via = ''] = /^(.*?)(\s+via\s.*)?$/i.exec(s);
  const p = ends.split(' - ');
  return p.length < 2 ? s : `${p[0]} to ${p.at(-1)}${p.length > 2 ? ` via ${p.slice(1, -1).join(', ')}` : via}`;
};
const whereOf = (r) => {
  const n = plain(r.name);
  if (n && !(r === route && !sub)) return toName(n);
  const e = r === route ? ends : routeEnds(system.key, r.slug);
  return e && e.from !== e.to ? `${e.from} to ${e.to}` : '';
};
const where = whereOf(route);
const shorten = (w) => w.replace(/\s*\([^)]*\)/g, '').replace(/\s+via\s.*$/i, '').trim();
const shortWhere = shorten(where);
// Only an "A to B" leads the title: a corridor name stays as it was ("Phoenix Valley Metro Bus
// Route 7 Schedule: 7th St" is our best-clicked title, and riders there search the street).
const a2b = Boolean(num) && / to /.test(where);
const shortName = sub.replace(/\s+via\s.*$/i, '');

// Routes in one system that share a number would share a title too: Transdev Blazefield runs a
// "4" in Blackburn, Burnley and Harrogate, and Oxford's 25A has a separate Sunday timetable. Each
// says what sets it apart: where it goes, else the days it runs, else the town it starts in.
// (A route the feed lists twice defers to the first instead, src/lib/variants.js.)
const DAY = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const daysOf = (r, short = false) => {
  const s = [...new Set(r.days.flatMap((d) => d.days))].sort((a, b) => a - b);
  if (s.length === 7) return 'daily';
  const D = short ? DAY.map((d) => d.slice(0, 3)) : DAY;
  const runs = [];
  for (const d of s) { const last = runs.at(-1); if (last && d === last[1] + 1) last[1] = d; else runs.push([d, d]); }
  return runs.map(([a, b]) => (a === b ? `${DAY[a]}s` : b === a + 1 ? `${D[a]}, ${D[b]}` : `${D[a]} to ${D[b]}`)).join(', ');
};
// The town (GeoNames, from the journeys) a route starts in; a loop starts and ends in one.
const townOf = (r) => {
  const e = r === route ? ends : routeEnds(system.key, r.slug);
  if (e?.from) return e.from;
  const d = [...r.directions].sort((a, b) => b.stops.length - a.stops.length)[0];
  return place(plain(d.stops[0].name)).replace(/,.*$/, '').replace(/\s+(Bus|Railway|Train)\s+Station.*$/i, '').trim();
};
const same = (a, b) => String(a || '').toUpperCase() === String(b || '').toUpperCase();
const twins = !route.short || mainRouteOf(system.key, route.slug) ? []
  : system.routes.filter((r) => r !== route && same(r.short, route.short) && (!route.label || r.label === route.label) && !mainRouteOf(system.key, r.slug));
const apart = (f) => { const mine = f(route); return mine && twins.every((r) => f(r) !== mine) ? mine : ''; };
// A route already named by where it goes (an "A to B" title, or a long-name label such as V/Line's
// "Bendigo to Melbourne via Gisborne") needs nothing more when that is what sets it apart.
const byDays = !apart(whereOf) && !apart(townOf) && Boolean(apart(daysOf));
const twinQ = !twins.length ? ''
  : apart(whereOf) ? (a2b || route.label ? '' : shorten(apart(whereOf)))
  : apart(townOf) || apart(daysOf);
const twinQs = byDays ? [twinQ, daysOf(route, true)] : [twinQ];

// Australians search "<n> bus route" as often as "<n> bus timetable" (Search Console, Oct-Nov
// 2026): their titles say both, "Route 400 Bus Timetable: ...", while room allows.
const auNum = system.cc === 'au' && num ? `Route ${num}` : '';
const titles = a2b
  ? [...(auNum ? [`${auNum} ${Word}: ${where} (${system.name})`, `${auNum} ${Word}: ${shortWhere} (${system.name})`, `${auNum} ${Word}: ${where}`, `${auNum} ${Word}: ${shortWhere}`] : []),
    `${num} ${Word}: ${where} (${system.name})`, `${num} ${Word}: ${shortWhere} (${system.name})`, `${num} ${Word}: ${where}`, `${num} ${Word}: ${shortWhere}`, `${num} ${Word} (${system.name})`]
  : [`${head} ${Word}${name ? `: ${name}` : ''}`,
    ...(num && sub ? [`${num} ${Word}: ${sub}`, `${num} ${Word}: ${shortName}`] : []),
    `${head} ${Word} and Map`, `${head} ${Word}`, `${label} ${Word} (${system.name})`, `${label} ${Word}`];
const plainTitle = twinQ
  ? fit(60, ...twinQs.flatMap((q) => titles.filter((c) => !c.endsWith(`(${system.name})`) && !c.endsWith(' and Map')).map((c) => `${c} (${q})`)))
  : fit(60, ...titles);
// The brand only when the whole title still fits a result line.
const title = plainTitle.length + 12 <= 60 ? `${plainTitle} | Stopwatch` : plainTitle;
const h1Base = a2b ? `${num} ${Word}: ${where}`
  : sharedNum ? `${num} ${Word}: ${sub}`
  : num && !name ? `${num} ${Word} (${system.name})`
  : `${route.label ? `${system.name}: ${label}` : `${system.name} ${label}`}${name ? `: ${name}` : ''}`;
// "4 Bus Timetable (Transdev Blazefield, Blackburn)", not two brackets in a row.
const h1 = !twinQ ? h1Base : h1Base.endsWith(')') ? h1Base.replace(/\)$/, `, ${twinQ})`) : `${h1Base} (${twinQ})`;
// A route with one trip a day (school and works services) has no "first" and "last": "first bus
// 2:35 pm, last 2:35 pm" read as a bug in the snippet of our most-shown Phoenix page.
const once = mainSummary.first === mainSummary.last;
const span = once ? `one ${v} a day, at ${t(mainSummary.first)}` : `first ${v} ${t(mainSummary.first)}, last ${t(mainSummary.last)}`;
const description = fit(155,
  `${system.name} ${label}${name ? ` ${name}` : ''} ${word}: ${span} ${main.label}${mainSummary.gap ? `, ${every(mainSummary.gap)}` : ''}. All ${stopW}s, both directions, map and next ${v}.`,
  `${system.name} ${label} ${word}: ${span} ${main.label}${mainSummary.gap ? `, ${every(mainSummary.gap)}` : ''}. All ${stopW}s, map and next ${v}.`,
  `${system.name} ${label} ${word}: ${span} ${main.label}. All ${stopW}s and next ${v}.`);

// A minor variant ("7S": one school trip on Route 7) sends riders and Google to its main route.
const mainRoute = mainRouteOf(system.key, route.slug);
const mainLabel = mainRoute && routeLabel(mainRoute);
const mainDay = mainRoute?.days[0];
const mainSpan = mainRoute && mainRoute.summary[mainDay.key];

const WEEKDAYS = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const covered = new Set(route.days.flatMap((d) => d.days));
const missing = WEEKDAYS.filter((_, i) => !covered.has(i));

// Places served, in the order a rider passes them: the timepoints (the stops the operator itself
// names) of the longest direction. Mixing both directions jumbled the lede ("serving Bargy Road,
// College Green, Castlegrange Sq"), and a tram stop's number ("Acland St #139") is not a place.
const along = [...route.directions].sort((a, b) => b.stops.length - a.stops.length)[0];
const places = [...new Set(along.columns.map((c) => place(plain(c.name)).replace(/\s*#\d+$/, '')))];
// At most five: the two ends and up to three timepoints between, in route order.
const shown = places.length > 5 ? [places[0], ...places.slice(1, -1).filter((_, i, a) => i % Math.ceil(a.length / 3) === 0).slice(0, 3), places.at(-1)] : places;
const placesText = shown.length > 1 ? `${shown.slice(0, -1).join(', ')} and ${shown.at(-1)}` : shown[0];

const dests = route.directions.map((d) => place(plain(d.stops.at(-1).name)));
const dirNames = route.directions.map((d, i) => {
  const clash = dests.filter((y) => y === dests[i]).length > 1;
  return clash
    ? { heading: `${label}: ${plain(d.headsign) || `direction ${i + 1}`}`, anchor: slugify(d.headsign) || `direction-${i + 1}` }
    : { heading: `${label} to ${dests[i]}`, anchor: `to-${slugify(dests[i])}` };
});
// Variant trips can share a destination sign too ("Route 848: Brandon Park SC" twice): say where each starts.
const clashing = dirNames.map((y) => dirNames.filter((z) => z.heading === y.heading).length > 1);
dirNames.forEach((y, i) => {
  if (!clashing[i]) return;
  const from = place(plain(route.directions[i].stops[0].name));
  y.heading += ` from ${from}`;
  y.anchor += `-from-${slugify(from)}`;
});
// Still the same (same start too): a short working differs in length.
const still = dirNames.map((y) => dirNames.filter((z) => z.heading === y.heading).length > 1);
dirNames.forEach((y, i) => { if (still[i]) y.heading += ` (${route.directions[i].stops.length} ${stopW}s)`; });
dirNames.forEach((y, i) => { if (dirNames.findIndex((z) => z.anchor === y.anchor) !== i) y.anchor += `-${i + 1}`; });

// Big networks (Melbourne has 700 bus routes) link the 40 routes either side of this one, not all of them.
const idx = system.routes.findIndex((r) => r.slug === route.slug);
const near = system.routes.length > 61 ? system.routes.slice(Math.max(0, Math.min(idx - 20, system.routes.length - 41)), Math.max(0, Math.min(idx - 20, system.routes.length - 41)) + 41) : system.routes;
const others = near.filter((r) => r.slug !== route.slug);
const holidayList = route.exceptions.filter((e) => e.holiday);
const otherExceptions = route.exceptions.filter((e) => !e.holiday);
const routeColor = route.color || 'var(--ink)';
const stopHref = (code) => `${base}/stop/${encodeURIComponent(code)}`;
const journeys = routeJourneys(system.key, route.slug, 10);
const connections = routeConnections(system.key, route);
const intro = routeIntro({ route, t, v, stopW, longest: along, mainDay: main, mainSummary });
const medianTime = (p) => { const d = p.trips[p.days[0].key].map((r) => r[1] - r[0]).sort((a, b) => a - b); return d[Math.floor(d.length / 2)]; };

const path = `${base.slice(1)}/${route.slug}`;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: x.c.name, item: `${SITE}/${system.cc}` },
    { '@type': 'ListItem', position: 2, name: system.name, item: `${SITE}${base}` },
    { '@type': 'ListItem', position: 3, name: label, item: `${SITE}/${path}` },
  ],
}];
const cfg = { tz: system.timezone, h24, routes: { [route.slug]: { days: route.days.map(({ key, days }) => ({ key, days })), exceptions: route.exceptions.map(({ date, runs }) => ({ date, runs })) } } };

const faq = [
  [`What time is the first ${label} ${v}?`, `${route.days.map((d) => route.summary[d.key] && `${d.label}: ${t(route.summary[d.key].first)}`).filter(Boolean).join('. ')}.`],
  [`What time is the last ${label} ${v}?`, `${route.days.map((d) => route.summary[d.key] && `${d.label}: ${t(route.summary[d.key].last)}`).filter(Boolean).join('. ')}. A time after midnight belongs to the evening before.`],
  ...(mainSummary.gap ? [[`How often does ${label} run?`, `${route.days.map((d) => route.summary[d.key]?.gap && `${d.label}: ${every(route.summary[d.key].gap)}`).filter(Boolean).join('. ')}, between ${t(420)} and ${t(1140)}.`]] : []),
  [`Does ${label} run at weekends?`, `Saturday: ${covered.has(5) ? 'yes' : 'no service'}. Sunday: ${covered.has(6) ? 'yes' : 'no service'}.`],
  ...(holidayList.length ? [[`Does ${label} run on public holidays?`, `${holidayList.map((e) => `${e.holiday} (${shortDate(e.date)}): ${runsText(e, route.days)}`).join('. ')}.`]] : []),
  [`Where does ${label} go?`, `${label} serves ${placesText}. The full list of ${stopW}s for each direction is below the ${word}s.`],
  [`Are these live ${v} times?`, `No. They are the published ${word} from ${possessive(plain(system.attribution?.text || system.name))} open data, refreshed ${dateFor(system.builtOn, system.cc)}. A ${v} can run early or late, and disruptions are not shown.`],
];

// ---- redesign: the next-departures panel, the stop line and its connections ----
const firstOf = (d) => place(plain(d.stops[0].name));
const lastOf = (d) => place(plain(d.stops.at(-1).name));
// Per direction, the main day's first and last trip and daytime frequency, read off its own
// timetable: shown in the next-departures panel before (and without) the script.
const dirSummary = route.directions.map((dir) => {
  const rows = dir.schedules[main.key] || [];
  const starts = rows.map((r) => r.find((v2) => v2 != null)).filter((v2) => v2 != null).sort((a, b) => a - b);
  const day = starts.filter((m2) => m2 >= 420 && m2 <= 1140);
  const gaps = day.slice(1).map((m2, i) => m2 - day[i]).filter((g) => g > 0).sort((a, b) => a - b);
  return { first: starts[0], last: starts.at(-1), n: starts.length, gap: gaps.length >= 3 ? gaps[Math.floor(gaps.length / 2)] : null };
});
// Other routes at each stop (only stops with their own page), as tappable badges on the stop line.
const routesAt = new Map(pageStops(system.key).filter((s) => stopPages.has(s.code)).map((s) => [s.code, [...new Set(s.routes.map((r) => r.route))]]));
const bySlug = new Map(system.routes.map((r) => [r.slug, r]));
const connAt = (code) => (routesAt.get(code) || []).filter((sl) => sl !== route.slug && bySlug.has(sl)).slice(0, 4).map((sl) => bySlug.get(sl));
const modeIcon = /subway|metro/.test(m) ? 'subway' : /tram|streetcar/.test(m) ? 'tram' : /ferry/.test(m) ? 'ferry' : /train|rail/.test(m) ? 'rail' : 'bus';
const ends2 = route.directions.length > 1 ? `${lastOf(route.directions[1])} ↔ ${lastOf(route.directions[0])}` : `${firstOf(route.directions[0])} ↔ ${lastOf(route.directions[0])}`;
const fmtLegend = h24 ? 'Times use the 24-hour clock.' : 'Times in 12-hour format (am/pm).';

---
<Base title={title} description={description} path={path} canonicalPath={mainRoute ? `${base.slice(1)}/${mainRoute.slug}` : undefined} jsonLd={jsonLd} og={system.key} speakable={['.lede', '.faq .answer']} system={system}>
<main class="wrap">
  <Crumbs cc={system.cc} items={[{ name: x.c.name, href: `/${system.cc}` }, { name: system.name, href: base }, { name: label }]} />

  <section class="page-head in">
    <RouteBadge route={route} lg />
    <div class="ph-main">
      <h1>{h1}</h1>
      <div class="meta-row">
        <span><Icon name={modeIcon} />{cap(m)} {word}</span>
        {!a2b && <span>{system.name}</span>}
        {a2b && <span>{system.name}</span>}
        <span>{ends2}</span>
        <span class="muted"><Icon name="calendar-blank" />Refreshed {dateFor(system.builtOn, system.cc)}</span>
      </div>
    </div>
    <div class="actions no-print">
      <button class="btn btn-dark" type="button" data-fav={`route:${system.key}/${route.slug}`} data-name={`${system.name} ${label}`} data-sub={name}><Icon name="star" /><span data-fav-label>Save</span></button>
      <button class="btn" type="button" data-share><Icon name="share-network" /><span data-share-label>Share</span></button>
      <button class="btn" type="button" data-print><Icon name="printer" /> Print / PDF</button>
    </div>
  </section>

  {mainRoute && (
    <div class="notice variant-of" style="margin:0 0 20px"><Icon name="info" /><div>
      {same(mainRoute.short, route.short) ? <p><b>The same {word} as {mainLabel}.</b> {possessive(plain(system.attribution?.text || system.name))} data lists this route twice, with the same timetable.</p> : <p><b>Looking for {mainLabel}?</b> {label} is only {mainSummary.trips === 1 ? `one ${v}` : `${mainSummary.trips} ${vs}`} a day. {mainLabel} runs {mainDay.label}{mainSpan.first === mainSpan.last ? <>, once at {t(mainSpan.first)}</> : <> from {t(mainSpan.first)} to {t(mainSpan.last)}</>}{mainSpan.gap ? <>, {every(mainSpan.gap)}</> : null}.</p>}
      <p><a class="btn btn-dark btn-sm" href={`${base}/${mainRoute.slug}`}>{mainLabel} {word} <Icon name="arrow-right" /></a></p>
    </div></div>
  )}

  <section class="nx in" aria-labelledby="next-h" data-nx data-rows="5" style="animation-delay:.1s">
    <div class="nx-head">
      <div style="display:flex;flex-wrap:wrap;align-items:center;gap:6px 14px"><h2 id="next-h"><span class="dot"></span>Next {vs}</h2><span class="sub" data-nx-day>{main.label} · scheduled</span></div>
      <span class="nx-now js-only">Now <span data-clock></span></span>
    </div>
    <div class="nx-dirs">
      {route.directions.map((dir, di) => (
        <div class="nx-dir" data-nx-dir={di}>
          <div class="nx-dir-head"><h3><a href={`#${dirNames[di].anchor}`}>To {dests[di]}</a></h3><span>from {firstOf(dir)}</span></div>
          <ol class="static">
            {dirSummary[di].n ? <>
              <li>{main.label}: first {v} <b>{t(dirSummary[di].first)}</b>, last <b>{t(dirSummary[di].last)}</b>.</li>
              <li>{dirSummary[di].gap ? <>About <b>{every(dirSummary[di].gap)}</b> in the daytime, {dirSummary[di].n} {vs} in all.</> : <>{dirSummary[di].n} {dirSummary[di].n === 1 ? v : vs} in all.</>}</li>
            </> : <li>No {vs} this way {main.label}.</li>}
          </ol>
          <button class="nx-more" type="button" hidden>Show more <Icon name="chevron-down" /></button>
        </div>
      ))}
    </div>
    <p class="nx-foot">Scheduled times at the first {stopW} in each direction, not live tracking. <a href={`#${dirNames[0].anchor}`}>Full {word}</a></p>
  </section>

  <div class="tt-zone">
  <div class="controls js-only no-print" data-controls>
    <div class="controls-in">
      <div class="seg" role="group" aria-label="Day">
        {route.days.map((d, i) => <button type="button" data-ctl-day={d.key} aria-pressed={i === 0 ? 'true' : 'false'}>{d.label}</button>)}
      </div>
      {route.directions.length > 1 && (
        <div class="seg" role="group" aria-label="Direction">
          {route.directions.map((_, di) => <button type="button" data-ctl-dir={di} aria-pressed={di === 0 ? 'true' : 'false'}>To {dests[di].length > 26 ? `${dests[di].slice(0, 24).trim()}…` : dests[di]}</button>)}
        </div>
      )}
      <div class="gap"></div>
      <div class="seg" role="group" aria-label="View">
        <button type="button" data-ctl-view="grid" aria-pressed="true">Full grid</button>
        <button type="button" data-ctl-view="stop" aria-pressed="false">By stop</button>
      </div>
    </div>
  </div>

  {route.directions.map((dir, di) => (
    <section class="direction" id={dirNames[di].anchor} data-dir={di} data-section data-route={route.slug} data-from={place(plain(dir.columns[0].name))} data-short={route.short || ''} data-color={badgeBg(route.color)} data-text={inkFor(route.color)} data-to={dests[di]} data-at={`from ${place(plain(dir.stops[0].name))}`} data-url={`#${dirNames[di].anchor}`}>
      <div class="dir-head">
        <h2>{dirNames[di].heading}</h2>
        <p>{dir.headsign ? <>Destination sign “{plain(dir.headsign)}” · </> : null}from {place(plain(dir.stops[0].name))} · {dir.stops.length} {stopW}s</p>
      </div>
      <p class="next-line" aria-live="polite"></p>
      {route.days.filter((d) => dir.schedules[d.key]).map((d, i) => (
        <div class={`panel${i === 0 ? ' on' : ''}`} data-day={d.key} role="region" aria-label={`${dirNames[di].heading}, ${d.label}`}>
          <h3>{d.label}</h3>
          <p class="legend">Times at the main {stopW}s. {fmtLegend} A dash means that trip does not stop there. The highlighted row is the next departure.</p>
          <div class="tt-wrap">
            <table class="tt">
              <thead><tr>{dir.columns.map((c) => <th scope="col">{stopPages.has(c.code) ? <a href={stopHref(c.code)}>{plain(c.name)}</a> : plain(c.name)}</th>)}</tr></thead>
              <tbody>
                {dir.schedules[d.key].map((row) => (
                  <tr data-m={row[0] ?? ''}>{row.map((mm) => {
                    if (mm == null) return <td class="no">-</td>;
                    const c = clock(mm, h24);
                    return <td class={c.pm ? 'pm' : undefined}>{c.text}</td>;
                  })}</tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
      <div class="bystop js-only" data-bystop hidden>
        <div class="pick">
          <label for={`pick-${di}`}>Your {stopW}</label>
          <select id={`pick-${di}`}>{dir.columns.map((c, ci) => <option value={ci}>{plain(c.name)}</option>)}</select>
          <p>Each row is an hour; the numbers are the minutes past the hour when a {v} leaves.</p>
        </div>
        <div class="hgrid"><table class="hours"><tbody></tbody></table></div>
      </div>
    </section>
  ))}
  </div>

  <section class="sec reveal" aria-labelledby="sum-h" style="padding-top:48px">
    <h2 id="sum-h" style="font-size:28px;margin-bottom:14px">Service at a glance</h2>
    <div class="glance">
      {route.days.map((d) => { const s = route.summary[d.key]; return s && (
        <div><h3>{d.label}</h3><dl>
          <div><dt>First</dt><dd>{t(s.first)}</dd></div>
          <div><dt>Last</dt><dd>{t(s.last)}{s.last >= 1440 ? ' (next day)' : ''}</dd></div>
          <div><dt>{cap(vs)}</dt><dd>{s.trips}</dd></div>
          <div><dt>Daytime</dt><dd>{s.gap ? every(s.gap) : 'Varies'}</dd></div>
        </dl></div>
      ); })}
      {missing.length > 0 && <div><h3>{missing.join(', ')}</h3><p class="none">No service</p></div>}
    </div>
  </section>

  {(route.exceptions.length > 0 || system.changesOn) && (
    <aside class="notice reveal" aria-label="Timetable changes"><Icon name="calendar-check" /><div>
      {holidayList.length > 0 && <p><b>Public holidays</b></p>}
      {holidayList.length > 0 && <ul>{holidayList.map((e) => <li>{shortDate(e.date)} ({e.holiday}): {runsText(e, route.days)}</li>)}</ul>}
      {otherExceptions.length > 0 && <p><b>Also different:</b> {otherExceptions.slice(0, 8).map((e) => `${shortDate(e.date)} (${runsText(e, route.days)})`).join('; ')}.</p>}
      {system.changesOn && <p><b>New {word} from {dateFor(system.changesOn, system.cc)}.</b> {possessive(system.name)} {word} changes that day. The times above are for the current {word}.</p>}
    </div></aside>
  )}

  <Ad slot="1697297769" />

  <section class="sec stops-wrap" aria-labelledby="stops-h">
    <div class="col-a reveal">
      <h2 id="stops-h" style="font-size:28px;margin-bottom:6px">{cap(stopW)}s and connections</h2>
      <p class="muted small" style="margin:0 0 20px">Every {stopW} with its own departures page is linked. Badges are other {system.name} {lineWord}s that call there.</p>
      {route.directions.map((dir, di) => (
        <div class="dir-stops" data-dir-stops={di}>
          <h3 style="margin:0 0 12px;font-size:18px;text-transform:uppercase">{firstOf(dir)} to {lastOf(dir)}</h3>
          <ol class="stopline" style={`--route:${badgeBg(route.color)}`}>
            {dir.stops.map((s) => { const tp = dir.columns.some((c) => c.code === s.code); const cn = connAt(s.code); return (
              <li class={tp ? 'tp' : undefined}><span class="dot"></span><span class="row">
                {stopPages.has(s.code) ? <a class="nm" href={stopHref(s.code)}>{plain(s.name)}</a> : <span class="nm">{plain(s.name)}</span>}
                <small>#{s.code}</small>
                {cn.length > 0 && <span class="cn">{cn.map((r) => <a href={`${base}/${r.slug}`} aria-label={`${system.name} ${plain(routeLabel(r))}`}><RouteBadge route={r} /></a>)}</span>}
              </span></li>
            ); })}
          </ol>
        </div>
      ))}
    </div>
    <div class="col-b reveal">
      <div class="mapcard">
        <div class="map" data-map={`/geo/${system.key}/${route.slug}.json`}>
          <button class="map-open" type="button"><Icon name="map-trifold" />Show {label} on a map</button>
        </div>
        <div class="cap"><span>{label} {lineWord} map</span><span>OpenStreetMap</span></div>
      </div>
      <div class="about-box">
        <h2>About {label}</h2>
        <p class="lede" style="font-size:15px">{system.name} {label}{name ? ` (${name})` : ''} is a {m} {lineWord} in {system.area}, serving {placesText}. {intro} Times from the operator's open data, refreshed {dateFor(system.builtOn, system.cc)}.</p>
      </div>
      {connections.length > 0 && (
        <div class="about-box">
          <h2>Main interchanges</h2>
          <ul class="list" style="border-top:0">
            {connections.map((cn) => (
              <li><a href={stopHref(cn.code)}><span>{plain(cn.name)}<span class="meta">{cn.routes.length} other {cn.routes.length === 1 ? lineWord : `${lineWord}s`}</span></span><Icon name="arrow-right" class="go-i" /></a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  {journeys.length > 0 && (
    <section class="sec reveal" aria-labelledby="tt-towns">
      <h2 id="tt-towns" style="font-size:28px;margin-bottom:14px">Town to town on {label}</h2>
      <div class="list-cols">
        {[journeys.slice(0, Math.ceil(journeys.length / 2)), journeys.slice(Math.ceil(journeys.length / 2))].map((col) => col.length > 0 && (
          <ul class="list">
            {col.map((jy) => <li><a href={jy.url}><span class="i-tile"><Icon name="path" /></span><span>{jy.from.name} to {jy.to.name}<span class="meta">{pairDaily(jy.p)} a day{jy.p.routes.length > 1 ? `, ${jy.p.routes.length} routes` : ''} · about {duration(medianTime(jy.p))}</span></span><Icon name="arrow-right" class="go-i" /></a></li>)}
          </ul>
        ))}
      </div>
    </section>
  )}

  <Faq items={faq} title={`${label} questions`} />
  <Source system={system} extra="These are scheduled times; disruptions and service alerts are published by the operator." />

  <Ad slot="9765370376" />

  {others.length > 0 && (
    <section class="sec reveal" aria-labelledby="other-h">
      <h2 id="other-h" style="font-size:28px;margin-bottom:16px">Other {system.name} {lineWord}s</h2>
      <ul class="rgrid auto">
        {others.map((r) => <li><a class="rcard card" href={`${base}/${r.slug}`}><RouteBadge route={r} size="md" /><span class="t">{plain(r.label || r.name || routeLabel(r))}<small>{r.days.map((d) => d.label).join(', ')}</small></span></a></li>)}
      </ul>
      {others.length < system.routes.length - 1 && <p style="margin-top:16px"><a class="btn btn-dark" href={base}>All {system.routes.length} {system.name} {lineWord}s <Icon name="arrow-right" /></a></p>}
    </section>
  )}
</main>
<script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />
</Base>
