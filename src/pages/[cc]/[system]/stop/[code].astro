---
import { SITE } from '../../../../lib/site.js';
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import Ad from '../../../../components/Ad.astro';
import RouteBadge from '../../../../components/RouteBadge.astro';
import Faq from '../../../../components/Faq.astro';
import Source from '../../../../components/Source.astro';
import Crumbs from '../../../../components/Crumbs.astro';
import { stopSystems, pageStops, stopInShard, hubOf, nearby, isIndexedStop } from '../../../../lib/data.js';
import { byHour, place, plain, inkFor, badgeBg, possessive, routeLabel, modeName, vehicle, plural, cap, stopWord, sharedVehicle, toward } from '../../../../lib/format.js';
import { ctxFor, dateFor } from '../../../../lib/page.js';

export function getStaticPaths() {
  return stopSystems().flatMap((system) => pageStops(system.key).filter((stop) => stopInShard(system.key, stop.code)).map((stop) => ({
    params: { cc: system.cc, system: system.slug, code: stop.code },
    props: { system, stop },
  })));
}

const { system, stop } = Astro.props;
const x = ctxFor(system);
const { t, base, h24, word, Word } = x;
const name = plain(stop.name);
const routeOf = (slug) => system.routes.find((r) => r.slug === slug);
const served = stop.routes.map((r) => routeOf(r.route)).filter(Boolean);
const types = served.map((r) => r.type);
const stopW = stopWord(types, system);
const v = sharedVehicle(served, system);
const vs = v === 'departure' ? 'departures' : plural(v);
const labelOf = (r) => { const route = routeOf(r.route); return route ? routeLabel(route) : (r.short ? `Route ${r.short}` : plain(r.name)); };
const routeNums = [...new Set(stop.routes.map((r) => r.short || plain(r.name)))];
const routeList = routeNums.length > 1 ? `${routeNums.slice(0, -1).join(', ')} and ${routeNums.at(-1)}` : routeNums[0];
const firstAll = Math.min(...stop.routes.flatMap((r) => Object.values(r.times).flat()));
const hub = hubOf(system.key, stop);
const near = nearby(system.key, stop);
const stopHref = (code) => `${base}/stop/${encodeURIComponent(code)}`;

// Departures by weekday (0 = Monday), across every route that calls here.
const timesOn = (wd) => stop.routes.flatMap((r) => {
  const d = routeOf(r.route)?.days.find((dd) => dd.days.includes(wd));
  return (d && r.times[d.key]) || [];
}).sort((a, b) => a - b);
const span = (wd) => { const tt = timesOn(wd); return tt.length ? { first: tt[0], last: tt.at(-1), n: tt.length, day: tt.filter((mm) => mm >= 420 && mm < 1140).length } : null; };
const mon = span(0), sat = span(5), sun = span(6);
const lines = [...new Map(stop.routes.map((r) => [`${r.short || r.name}>${toward(r.headsign)}`, `${labelOf(r)} to ${toward(r.headsign)}`])).values()];
const linesText = lines.length > 8 ? `${lines.slice(0, 8).join(', ')} and ${lines.length - 8} more` : lines.join(', ');
const spanText = (label, s) => (s ? `${label}: first ${v} ${t(s.first)}, last ${t(s.last)} (${s.n} ${vs})` : `${label}: no ${vs}`);
const perHour = mon?.day ? mon.day / 12 : 0;
const modeWord = (() => { const set = new Set(served.map((r) => modeName(r.type, system))); return set.size === 1 ? [...set][0] : 'transit'; })();
const timesWord = modeWord === 'transit' ? 'Departures' : `${cap(modeWord.split(' ')[0] === 'light' ? 'train' : v)} Times`;

// "orchard park exchange bay f" is a real autocomplete query: the stop's own name leads, and
// the stop number is always kept so stops sharing a name (two sides of one road) never share a title.
const fit = (max, ...c) => c.find((s) => s.length <= max) ?? c.at(-1);
// UK stop codes are national (NaPTAN), so one stop can have a page under each operator that calls
// there (Bournemouth: morebus and unibus): those titles name the operator to stay distinct.
const title = fit(60, ...(system.cc === 'uk' ? [`${name}: ${system.name} ${timesWord} (Stop ${stop.code})`, `${name}, ${system.name} (Stop ${stop.code})`] : []), `${name} ${timesWord} (Stop ${stop.code})`, `${name} (Stop ${stop.code})`, `${name.slice(0, 40).trim()}… (Stop ${stop.code})`);
const description = fit(155,
  `${cap(v === 'departure' ? 'departure' : v)} times at ${name}, ${system.name} (stop ${stop.code}): ${routeNums.length > 1 ? 'routes' : 'route'} ${routeList}.${mon ? ` Weekdays ${t(mon.first)} to ${t(mon.last)}.` : ''} Next ${v} and full ${word}.`,
  `${cap(v === 'departure' ? 'departure' : v)} times at ${name}, ${system.name} (stop ${stop.code}): ${routeNums.slice(0, 6).join(', ')}${routeNums.length > 6 ? ' and more' : ''}. Next ${v} and full ${word}.`,
  `${cap(v === 'departure' ? 'departure' : v)} times at ${name}, ${system.name} (stop ${stop.code}). Next ${v} and full ${word}.`);

const faq = [
  [`Which ${v === 'departure' ? 'services' : vs} stop at ${name}?`, `${linesText} ${lines.length === 1 ? 'stops' : 'stop'} at ${name} (stop ${stop.code}) in ${system.name}.`],
  [`When is the first and last ${v} at ${name}?`, `${[spanText('Monday', mon), spanText('Saturday', sat), spanText('Sunday', sun)].join('. ')}. Public holiday ${word}s can differ; each route page lists them.`],
  ...(mon && mon.day ? [[`How often do ${vs} come to ${name}?`, perHour >= 1 ? `On a Monday about ${Math.round(perHour)} ${Math.round(perHour) === 1 ? v : vs} an hour stop here between ${t(420)} and ${t(1140)} (${mon.day} in those twelve hours, all routes together).` : `On a Monday ${mon.day} ${mon.day === 1 ? v : vs} stop here between ${t(420)} and ${t(1140)}, roughly one every ${Math.round(720 / mon.day)} minutes.`]] : []),
  ...(hub ? [[`Is ${name} part of ${plain(hub.name)}?`, `Yes. It is one of ${hub.stops.length} stops at ${plain(hub.name)}. The ${plain(hub.name)} page lists the next departures from all of them and which routes use each one.`]] : []),
  ...(near.length ? [[`What other stops are near ${name}?`, `The closest are ${near.slice(0, 3).map(({ stop: s, m }) => `${plain(s.name)} (${s.code}, about ${Math.max(1, Math.round(m / 80))} min walk)`).join(', ')}.`]] : []),
  ['Are these live arrival times?', `No. They are the scheduled times from ${possessive(system.name)} published ${word}, refreshed ${dateFor(system.builtOn, system.cc)}. A ${v === 'departure' ? 'service' : v} can run early or late, and disruptions are not shown.`],
];

const path = `${base.slice(1)}/stop/${encodeURIComponent(stop.code)}`;
// The embed code (src/pages/embed.astro): an iframe, plus a plain link under it so the stop's page is credited.
const embedCode = `<iframe src="${SITE}/embed?s=${path}" title="Next ${vs} at ${name.replace(/"/g, '&quot;')}" width="100%" height="330" style="border:0;max-width:480px" loading="lazy"></iframe>\n<p style="font:13px sans-serif;margin:4px 0"><a href="${SITE}/${path}">${name.replace(/</g, '&lt;')} ${v} times</a> by Stopwatch</p>`;
const isRail = stopW === 'station';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: x.c.name, item: `${SITE}/${system.cc}` },
      { '@type': 'ListItem', position: 2, name: system.name, item: `${SITE}${base}` },
      { '@type': 'ListItem', position: 3, name, item: `${SITE}/${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': isRail ? 'TrainStation' : modeWord === 'ferry' ? 'BoatTerminal' : 'BusStop',
    name,
    identifier: stop.code,
    ...(stop.lat ? { geo: { '@type': 'GeoCoordinates', latitude: stop.lat, longitude: stop.lon } } : {}),
    containedInPlace: { '@type': 'Place', name: system.area },
  },
];
const cfg = { tz: system.timezone, h24, routes: Object.fromEntries(stop.routes.map((r) => { const route = routeOf(r.route); return [`${r.route}|${r.headsign}`, { days: route?.days.map(({ key, days }) => ({ key, days })) || [], exceptions: route?.exceptions.map(({ date, runs }) => ({ date, runs })) || [] }]; })) };

// ---- redesign ----
// Night-only routes (every time between 11 pm and 5:30 am) fold into one row under the daytime ones.
const isNight = (r) => { const all2 = Object.values(r.times).flat(); return all2.length > 0 && all2.every((mm) => { const d = mm % 1440; return d >= 1380 || d < 330; }); };
const dayRoutes = stop.routes.map((r, i) => ({ r, i })).filter(({ r }) => !isNight(r));
const nightRoutes = stop.routes.map((r, i) => ({ r, i })).filter(({ r }) => isNight(r));
const firstOn = (r) => { const d = r.days[0]; const tt = (d && r.times[d.key]) || []; return tt.length ? { label: d.label, first: tt[0], last: tt.at(-1) } : null; };
const uniqueRoutes = [...new Map(stop.routes.map((r) => [r.route, r])).values()];
const nightNames = [...new Set(nightRoutes.map(({ r }) => labelOf(r)))];
// The weekday span riders mean: daytime routes only (night routes would make it "3:54 am to 5:57 am").
const dayTimes = dayRoutes.flatMap(({ r }) => { const d = routeOf(r.route)?.days.find((dd) => dd.days.includes(0)); return (d && r.times[d.key]) || []; }).sort((a, b) => a - b);
const daySpan = dayTimes.length ? { first: dayTimes[0], last: dayTimes.at(-1) } : null;
const tNext = (m) => `${t(m)}${m >= 1440 ? ' (next day)' : ''}`;

---
<Base title={title} description={description} path={path} jsonLd={jsonLd} og={system.key} speakable={['.lede', '.faq .answer']} system={system}>
<main class="wrap">
  <Crumbs cc={system.cc} items={[{ name: x.c.name, href: `/${system.cc}` }, { name: system.name, href: base }, ...(hub ? [{ name: plain(hub.name), href: `${base}/hub/${hub.slug}` }] : []), { name: `Stop ${stop.code}` }]} />

  <section class="page-head in" style="align-items:flex-end">
    <div class="ph-main" style="flex:1 1 520px;gap:12px">
      <div style="display:flex;align-items:center;gap:10px"><span class="stop-icon"><Icon name="stop-post" /></span><span class="code-chip">Stop code {stop.code}</span></div>
      <h1>{name} departures</h1>
      <p style="margin:0;font-size:16px">{system.name} · served by {routeNums.length} {routeNums.length === 1 ? 'route' : 'routes'}{nightNames.length ? `, including ${nightNames.length} night ${nightNames.length === 1 ? 'route' : 'routes'}` : ''}</p>
      <div class="badges">{uniqueRoutes.slice(0, 24).map((r) => <a href={`${base}/${r.route}`} aria-label={`${labelOf(r)} ${word}`}><RouteBadge route={{ short: r.short, color: r.color }} size="md" /></a>)}</div>
    </div>
    <div class="actions no-print">
      <button class="btn btn-dark" type="button" data-fav={`stop:${system.key}/${stop.code}`} data-name={name} data-sub={`${system.name} · ${stop.code}`}><Icon name="star" /><span data-fav-label>Save</span></button>
      <button class="btn" type="button" data-share><Icon name="share-network" /><span data-share-label>Share</span></button>
      {stop.lat && <a class="btn" href={`https://www.google.com/maps/search/?api=1&query=${stop.lat},${stop.lon}`} rel="nofollow"><Icon name="map-trifold" /> Directions</a>}
      {hub && <a class="btn" href={`${base}/hub/${hub.slug}`}><Icon name="bus" /> All of {plain(hub.name)}</a>}
    </div>
  </section>

  <section class="nx in" aria-labelledby="nx-h" data-board data-rows="8" data-merged style="animation-delay:.1s">
    <div class="nx-head">
      <h2 id="nx-h"><span class="dot"></span>Next from this {stopW}</h2>
      <span class="nx-now js-only">Now <span data-clock></span></span>
    </div>
    <ol class="merged">
      {stop.routes.slice(0, 8).map((r) => { const f = firstOn(r); return (
        <li>
          <RouteBadge route={{ short: r.short, color: r.color }} />
          <span class="note"><b>To {toward(r.headsign)}</b>{f ? `${f.label}: first ${t(f.first)}, last ${t(f.last)}` : ''}</span>
        </li>
      ); })}
    </ol>
    <button class="nx-more" type="button" hidden>Show more <Icon name="chevron-down" /></button>
    <p class="nx-foot">All routes merged and sorted by time · scheduled, not live. The first {v} of the day leaves at {t(firstAll)}.</p>
  </section>

  <section class="sec" aria-labelledby="by-h" style="padding-top:48px">
    <div class="sec-head reveal">
      <h2 id="by-h" style="font-size:clamp(26px,2.6vw,32px)">Timetables by route</h2>
      <p>{nightRoutes.length ? 'Daytime routes first, night routes below' : 'Routes leaving soonest come first'} · {h24 ? '24-hour clock' : 'times in 12-hour format'}</p>
    </div>
    <div class="by-route" data-sortable>
      {dayRoutes.map(({ r }) => { const key = `${r.route}|${r.headsign}`; const route = routeOf(r.route); return (
        <article class="rsec reveal" data-section data-route={key} data-short={r.short || ''} data-color={badgeBg(r.color)} data-text={inkFor(r.color)} data-to={toward(r.headsign)} data-url={`${base}/${r.route}`}>
          <header>
            <RouteBadge route={{ short: r.short, color: r.color }} size="md" />
            <span class="t"><h3><a href={`${base}/${r.route}`}>{labelOf(r)}</a></h3><small>to {toward(r.headsign)}</small></span>
            <span class="nextchip" data-nextchip></span>
          </header>
          <div class="seg" role="tablist" aria-label={`${labelOf(r)}: day of the week`}>
            {r.days.filter((d) => r.times[d.key]).map((d, i) => <button type="button" role="tab" data-day={d.key} aria-selected={i === 0 ? 'true' : 'false'}>{d.label}</button>)}
          </div>
          <p class="next-line" aria-live="polite"></p>
          {r.days.filter((d) => r.times[d.key]).map((d, i) => (
            <div class={`panel${i === 0 ? ' on' : ''}`} data-day={d.key} role="tabpanel">
              <h3>{d.label}, {r.times[d.key].length} {r.times[d.key].length === 1 ? (route ? vehicle(route.type, system) : 'departure') : (route ? plural(vehicle(route.type, system)) : 'departures')}</h3>
              <table class="hours">
                <tbody>
                  {byHour(r.times[d.key], h24).map((h) => (
                    <tr data-h={h.h}><th>{h.label}{!h24 && <> {h.pm ? 'pm' : 'am'}</>}{h.h >= 24 ? '+' : ''}</th><td>{h.mins.map((mm) => <span data-m={mm.m}>{mm.text}</span>)}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
          <a class="full" href={`${base}/${r.route}`}>Full day timetable for {labelOf(r)}</a>
        </article>
      ); })}
    </div>
    {nightRoutes.length > 0 && (
      <details class="night reveal">
        <summary>
          <span class="stop-icon"><Icon name="clock" /></span>
          <span style="flex:1"><b>Night service · {nightNames.join(', ')}</b><small>Runs overnight only</small></span>
          <Icon name="chevron-down" />
        </summary>
        <div class="by-route">
          {nightRoutes.map(({ r }) => { const key = `${r.route}|${r.headsign}`; const route = routeOf(r.route); return (
            <article class="rsec" data-section data-route={key} data-short={r.short || ''} data-color={badgeBg(r.color)} data-text={inkFor(r.color)} data-to={toward(r.headsign)} data-url={`${base}/${r.route}`}>
              <header>
                <RouteBadge route={{ short: r.short, color: r.color }} size="md" />
                <span class="t"><h3><a href={`${base}/${r.route}`}>{labelOf(r)}</a></h3><small>to {toward(r.headsign)}</small></span>
                <span class="nextchip" data-nextchip></span>
              </header>
              <div class="seg" role="tablist" aria-label={`${labelOf(r)}: day of the week`}>
                {r.days.filter((d) => r.times[d.key]).map((d, i) => <button type="button" role="tab" data-day={d.key} aria-selected={i === 0 ? 'true' : 'false'}>{d.label}</button>)}
              </div>
              <p class="next-line" aria-live="polite"></p>
              {r.days.filter((d) => r.times[d.key]).map((d, i) => (
                <div class={`panel${i === 0 ? ' on' : ''}`} data-day={d.key} role="tabpanel">
                  <h3>{d.label}, {r.times[d.key].length} {r.times[d.key].length === 1 ? (route ? vehicle(route.type, system) : 'departure') : (route ? plural(vehicle(route.type, system)) : 'departures')}</h3>
                  <table class="hours"><tbody>
                    {byHour(r.times[d.key], h24).map((h) => (
                      <tr data-h={h.h}><th>{h.label}{!h24 && <> {h.pm ? 'pm' : 'am'}</>}{h.h >= 24 ? '+' : ''}</th><td>{h.mins.map((mm) => <span data-m={mm.m}>{mm.text}</span>)}</td></tr>
                    ))}
                  </tbody></table>
                </div>
              ))}
              <a class="full" href={`${base}/${r.route}`}>Full overnight timetable for {labelOf(r)}</a>
            </article>
          ); })}
        </div>
      </details>
    )}
    <p class="source" style="margin-top:20px">Read each row as the hour, then the minutes past it: {h24 ? '07 then 05 35 means 07:05 and 07:35.' : '7 am then 05 35 means 7:05 am and 7:35 am.'} A "+" after the hour marks trips after midnight that belong to the day before. Scheduled times from {possessive(system.name)} published {word} data, refreshed {dateFor(system.builtOn, system.cc)}. Not live arrivals.</p>
  </section>

  <Ad />

  <section class="sec twocol">
    <div class="reveal lede-box">
      <h2 style="font-size:24px;margin-bottom:10px">About this {stopW}</h2>
      <p class="lede" style="font-size:16px">{name} is a {modeWord === 'transit' ? 'transit' : modeWord} {stopW} on the {system.name} network (stop {stop.code}), served by {linesText}.{daySpan ? ` On weekdays the first ${v} leaves at ${t(daySpan.first)} and the last at ${tNext(daySpan.last)}${nightRoutes.length ? `, with night ${nightNames.length === 1 ? 'route' : 'routes'} ${nightNames.join(', ')} overnight` : ''}.` : ''}{hub ? ` It is one of ${hub.stops.length} stops at ${plain(hub.name)}.` : ''}</p>
      {near.length > 0 && <>
        <h2 style="font-size:24px;margin:24px 0 10px">Stops nearby</h2>
        <ul class="list near-list">
          {near.map(({ stop: s, m }) => { const body = <><span class="i-tile"><Icon name="map-pin" /></span><span>{plain(s.name)}<span class="meta">{s.code} · about {Math.max(1, Math.round(m / 80))} min walk ({Math.round(m / 10) * 10} m)</span></span></>; return isIndexedStop(system.key, s.code)
            ? <li><a href={stopHref(s.code)}>{body}<Icon name="arrow-right" class="go-i" /></a></li>
            : <li><span class="row">{body}</span></li>; })}
        </ul>
      </>}
    </div>
    <div class="embed-box reveal no-print">
      <div style="display:flex;align-items:center;gap:10px"><Icon name="code" /><h2>Put these times on your website</h2></div>
      <p>For a school, club, café or community site near this {stopW}: paste this code into your page and it shows the next {vs} here, worked out again every 30 seconds. Free, no sign-up, with a link back.</p>
      <textarea class="embed-code" readonly rows="5" aria-label="Embed code">{embedCode}</textarea>
      <button class="btn btn-primary btn-sm" type="button" data-copy><Icon name="copy" /><span data-copy-label>Copy code</span></button>
    </div>
  </section>

  <Faq items={faq} title={`Questions about ${name}`} />
  <Source system={system} />
  <Ad slot="9765370376" />
</main>
<script type="application/json" id="cfg" set:html={JSON.stringify(cfg)} />
</Base>
