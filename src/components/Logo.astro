---
/** The Stopwatch mark: same geometry as scripts/make-images.mjs MARK. */
interface Props { size?: number }
const { size = 30 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect x="12.6" y="1.4" width="6.8" height="3.6" rx="1.3" fill="currentColor"/>
  <rect x="15" y="4.4" width="2" height="2.8" fill="currentColor"/>
  <rect x="24.2" y="6.1" width="3.2" height="2.6" rx="1" transform="rotate(42 25.8 7.4)" fill="currentColor"/>
  <circle cx="16" cy="18.6" r="11.6" fill="#f2a516" stroke="currentColor" stroke-width="2.6"/>
  <path d="M16 18.6 L21.4 12.9" stroke="#15171a" stroke-width="2.8" stroke-linecap="round"/>
  <circle cx="16" cy="18.6" r="2.1" fill="#15171a"/>
</svg>
