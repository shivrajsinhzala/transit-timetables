---
/** The source line under every timetable: who published the data, under which licence, and when it was refreshed. */
import { plain } from '../lib/format.js';
import { dateFor } from '../lib/page.js';
interface Props { system: any; extra?: string }
const { system, extra } = Astro.props;
const a = system.attribution || {};
---
<p class="small muted source">
  Source: <a href={a.url} rel="nofollow">{plain(a.text)}</a> open data (GTFS schedule{system.name ? ` for ${system.name}` : ''}){a.license && <>, used under {/licen[cs]e|terms/i.test(a.license) ? 'the ' : ''}<a href={a.licenseUrl} rel="nofollow license">{plain(a.license)}</a></>}. Refreshed {dateFor(system.builtOn, system.cc)}{system.feed?.to ? `; the current timetable runs to ${dateFor(system.feed.to, system.cc)}` : ''}.{extra ? ` ${extra}` : ''}{/Open Government Licence v3/.test(a.license || '') ? ' Contains public sector information licensed under the Open Government Licence v3.0.' : ''} Changes made: times reformatted into timetables and departure lists.
</p>
