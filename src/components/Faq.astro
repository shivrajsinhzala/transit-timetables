---
/**
 * Questions and answers, written for answer engines: each question is a real heading (H3), each
 * answer a short direct paragraph right under it, nothing collapsed. The FAQPage JSON-LD is built
 * from the same strings, so the markup can never claim anything the page does not show.
 */
import { indexable } from '../lib/indexing.js';
/** ld: false for questions about the site rather than about this page's timetable (home, country). */
interface Props { items: [string, string][]; title?: string; id?: string; ld?: boolean }
const { items, title, id = 'questions', ld = true } = Astro.props;
// FAQPage markup only on pages Google may index, where every answer is this page's own data: on
// tens of thousands of noindex stop and town pages it would be the same template stamped out again.
const pagePath = Astro.url.pathname.replace(/^\/+|\.html$/g, '').replace(/\/$/, '');
const withLd = ld && indexable(pagePath);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<section class="faq" id={id}>
  {title && <h2>{title}</h2>}
  {items.map(([q, a]) => (
    <div class="qa">
      <h3>{q}</h3>
      <p class="answer">{a}</p>
    </div>
  ))}
  {withLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</section>
