# Fingerprinted build output never changes under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Regenerated on each weekly refresh.
/geo/*
  Cache-Control: public, max-age=86400
/og/*
  Cache-Control: public, max-age=604800
/search.json
  Cache-Control: public, max-age=3600

# The service worker must always be re-checked, or an old one can pin old pages.
/sw.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# MapLibre, unbundled, in a folder named for its version.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
